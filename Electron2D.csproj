<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Electron2D</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <EmbeddedResource Include="src/Servers/Rendering/Shaders/*.spv" LogicalName="Electron2D.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.16.0" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SDL3-CS.Linux.Image" Version="3.4.6.9" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SDL3-CS.Linux.Shadercross" Version="3.0.0.11" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
  <ItemGroup>
    <None Update="LICENSE;THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="Always" />
    <None Update="src/Vendor/SDL3-CS/UPSTREAM-LICENSE.txt;src/Vendor/Box2D.NET/LICENSE;src/Vendor/Clipper2/LICENSE;src/Vendor/FastNoiseLite/LICENSE" CopyToPublishDirectory="Always" />
    <None Update="docs/licenses/PCG32-LICENSE.txt;docs/licenses/PolyPartition-LICENSE.txt;docs/coverage/GODOT-LICENSE.txt;docs/licenses/native/*" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
