<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmMainHTMLPath>wwwroot/index.html</WasmMainHTMLPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TrimMode>full</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Electron2D.csproj" SetRuntimeIdentifier="RuntimeIdentifier=browser-wasm" AdditionalProperties="RuntimeIdentifier=browser-wasm" Condition="'$(Electron2DUsePackage)' != 'true'" />
    <Compile Include="../Portability/ContractChecks.cs" Link="ContractChecks.cs" />
    <Compile Include="../Electron2D.Tests/NativeFontPrecisionTests.cs;../Electron2D.Tests/FontTestFixtures.cs;../Electron2D.Tests/ImageCodecTests.cs;../Electron2D.Tests/NativeTextBreakTests.cs" Link="%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Electron2D.Tests/Fixtures/Fonts/*.woff2;../Electron2D.Tests/Fixtures/Fonts/*.ttf" LogicalName="TestFonts.%(Filename)%(Extension)" />
    <Content Update="wwwroot/main.js;wwwroot/index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../tools/native-consumer.props" />
</Project>
