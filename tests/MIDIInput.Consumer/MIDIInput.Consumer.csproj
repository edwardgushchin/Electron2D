  </ItemGroup>
  <PropertyGroup Condition="'$(PublishAot)' != 'true' And '$(PublishTrimmed)' != 'true'">
    <DefineConstants>$(DefineConstants);MIDI_WINMM_FIXTURE_HOST</DefineConstants>
  </PropertyGroup>
  <Import Project="../../tools/native-consumer.props" />
</Project>
