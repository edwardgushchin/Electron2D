<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <TargetFramework Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('tvos'))">net10.0-tvos</TargetFramework>
    <ApplicationId>org.electron2d.tests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <DynamicCodeSupport>false</DynamicCodeSupport>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Electron2D.csproj" SetRuntimeIdentifier="RuntimeIdentifier=$(RuntimeIdentifier)" AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
    <Compile Include="../Portability/ContractChecks.cs" Link="ContractChecks.cs" />
    <Compile Include="../Portability/NativeChecks.cs" Link="NativeChecks.cs" />
    <Compile Include="../Electron2D.Tests/NativeFontPrecisionTests.cs" Link="NativeFontPrecisionTests.cs" />
    <Compile Include="../Electron2D.Tests/FontTestFixtures.cs" Link="FontTestFixtures.cs" />
    <EmbeddedResource Include="../Electron2D.Tests/Fixtures/Fonts/*.woff2;../Electron2D.Tests/Fixtures/Fonts/*.ttf" LogicalName="TestFonts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
