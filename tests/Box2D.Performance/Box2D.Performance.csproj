<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS0649</NoWarn>
    <DefineConstants Condition="'$(SerialBaseline)' == 'true'">$(DefineConstants);BOX2D_SERIAL_BASELINE</DefineConstants>
    <VendorRoot Condition="'$(VendorRoot)' == ''">../../src/Vendor/Box2D.NET</VendorRoot>
  </PropertyGroup>
  <ItemGroup><Compile Condition="'$(SerialBaseline)' != 'true'" Include="../../src/Servers/Physics/PhysicsTaskScheduler.cs" Link="PhysicsTaskScheduler.cs" /><Compile Include="../Electron2D.Tests/Box2DSIMDTests.cs" Link="Box2DSIMDTests.cs" /><Compile Include="$(VendorRoot)/*.cs" Link="Backend/%(Filename)%(Extension)" /></ItemGroup>
</Project>
