<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot><TieredCompilation>false</TieredCompilation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors><TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Electron2D.csproj" />
    <Compile Include="../Electron2D.Tests/NativeICUAllocationChecks.cs" Link="NativeICUAllocationChecks.cs" />
    <Compile Include="../Electron2D.Tests/NativeRegExAllocationChecks.cs" Link="NativeRegExAllocationChecks.cs" />
    <Compile Include="../Electron2D.Tests/NativeMSDFAllocationChecks.cs" Link="NativeMSDFAllocationChecks.cs" />
    <Compile Include="../Electron2D.Tests/AllocationWarmupCheck.cs" Link="AllocationWarmupCheck.cs" />
  </ItemGroup>
  <Import Project="../../tools/native-consumer.props" />
</Project>
