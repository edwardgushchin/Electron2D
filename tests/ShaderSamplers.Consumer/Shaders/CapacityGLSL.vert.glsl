#version 450
layout(location=0) in vec2 position; layout(location=1) in vec4 color; layout(location=2) in vec2 uv;
layout(set=1,binding=0,std140) uniform Frame { vec2 size; };
layout(location=0) out vec4 outColor; layout(location=1) out vec2 outUV;
layout(set=0,binding=0) uniform sampler2D v0;
layout(set=0,binding=1) uniform sampler2D v1;
layout(set=0,binding=2) uniform sampler2D v2;
layout(set=0,binding=3) uniform sampler2D v3;
layout(set=0,binding=4) uniform sampler2D v4;
layout(set=0,binding=5) uniform sampler2D v5;
layout(set=0,binding=6) uniform sampler2D v6;
layout(set=0,binding=7) uniform sampler2D v7;
layout(set=0,binding=8) uniform sampler2D v8;
layout(set=0,binding=9) uniform sampler2D v9;
layout(set=0,binding=10) uniform sampler2D v10;
layout(set=0,binding=11) uniform sampler2D v11;
layout(set=0,binding=12) uniform sampler2D v12;
layout(set=0,binding=13) uniform sampler2D v13;
layout(set=0,binding=14) uniform sampler2D v14;
layout(set=0,binding=15) uniform sampler2D v15;
void main(){ vec4 sampled = vec4(0);
sampled += textureLod(v0,vec2(.25),0);
sampled += textureLod(v1,vec2(.25),0);
sampled += textureLod(v2,vec2(.25),0);
sampled += textureLod(v3,vec2(.25),0);
sampled += textureLod(v4,vec2(.25),0);
sampled += textureLod(v5,vec2(.25),0);
sampled += textureLod(v6,vec2(.25),0);
sampled += textureLod(v7,vec2(.25),0);
sampled += textureLod(v8,vec2(.25),0);
sampled += textureLod(v9,vec2(.25),0);
sampled += textureLod(v10,vec2(.25),0);
sampled += textureLod(v11,vec2(.25),0);
sampled += textureLod(v12,vec2(.25),0);
sampled += textureLod(v13,vec2(.25),0);
sampled += textureLod(v14,vec2(.25),0);
sampled += textureLod(v15,vec2(.25),0);
gl_Position=vec4(position.x/size.x*2-1,1-position.y/size.y*2,0,1); outColor=color*sampled/16; outUV=uv;
}
