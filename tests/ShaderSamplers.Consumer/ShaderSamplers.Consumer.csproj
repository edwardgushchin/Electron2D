<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Electron2DShaderImportTool>../../tools/shaders/bin/$(Configuration)/net10.0/Electron2D.ShaderImport</Electron2DShaderImportTool>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../Electron2D.csproj" /></ItemGroup>
  <ItemGroup><Compile Include="../Electron2D.Tests/TextureSwizzleRuntimeChecks*.cs" Link="%(Filename)%(Extension)" /></ItemGroup>
  <Import Project="../../tools/native-consumer.props" />
  <ItemGroup>
    <Electron2DShader Include="Shaders/Device/*.comp.glsl" Stage="compute" Profile="device" />
    <Electron2DShader Include="Shaders/Device/*.vert.glsl" Stage="vertex" Profile="device" />
    <Electron2DShader Include="Shaders/Device/*.frag.glsl" Stage="fragment" Profile="device" />
    <Electron2DShader Include="Shaders/*.frag.glsl;Shaders/*.frag.hlsl" Stage="fragment" Profile="canvas" />
    <Electron2DShader Update="Shaders/Blit*.frag.*" Profile="texture-blit" />
    <Electron2DShader Include="Shaders/*.vert.glsl" Stage="vertex" Profile="canvas" />
    <Electron2DShader Include="Shaders/*.comp.glsl;Shaders/*.comp.hlsl" Stage="compute" Profile="particles" />
  </ItemGroup>
  <Import Project="../../tools/shaders/Electron2D.Shaders.targets" />
  <Target Name="BuildSamplerImportTool" BeforeTargets="_CompileElectron2DShaders">
    <MSBuild Projects="../../tools/shaders/ShaderImport.csproj" Targets="Restore;Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(NETCoreSdkRuntimeIdentifier)"
             RemoveProperties="PublishAot;PublishTrimmed;TrimMode;SelfContained;IlcTreatWarningsAsErrors;ILLinkTreatWarningsAsErrors" />
  </Target>
</Project>
