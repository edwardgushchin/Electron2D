<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredCompilation Condition="'$(Configuration)' == 'Release'">false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Fixtures/StandardInputHost.py" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Fixtures/ImporterMeshOracle.json" LogicalName="Electron2D.Mesh.ImporterOracle" />
    <EmbeddedResource Include="Fixtures/MeshCompressionOracle.json" LogicalName="Electron2D.Mesh.CompressionOracle" />
    <EmbeddedResource Include="TestData/Noise/image-reference.json" LogicalName="TestNoise.image-reference.json" />
    <EmbeddedResource Include="TestData/Noise/rgba-reference.json" LogicalName="TestNoise.rgba-reference.json" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" PrivateAssets="all" Publish="true" />
    <ProjectReference Include="../../Electron2D.csproj" />
    <Compile Include="../../tools/physics-memory/ProcessMemory.cs" Link="PhysicsMemory/ProcessMemory.cs" />
    <ProjectReference Include="../PhysicsBackendExtension.Consumer/PhysicsBackendExtension.Consumer.csproj" />
    <Compile Include="../PhysicsBodyExtension.Consumer/ControlledState.cs" Link="Consumers/ControlledState.cs" />
    <Compile Include="../../examples/PhysicsResultConstruction/ResultConstructionChecks.cs" Link="Examples/PhysicsResultConstruction/ResultConstructionChecks.cs" />
    <Compile Include="../../examples/WorkerRoutes/RoutePlanner.cs" Link="Examples/WorkerRoutes/RoutePlanner.cs" />
    <Compile Include="../../examples/ProceduralNoise/NoiseAssets.cs" Link="Examples/NoiseAssets.cs" /><Compile Include="../../examples/ProceduralNoise/NoiseScene.cs" Link="Examples/NoiseScene.cs" />
    <Compile Include="../../examples/IterationRoutes/IterationAssets.cs;../../examples/IterationRoutes/IterationScene.cs" Link="Examples/IterationRoutes/%(Filename)%(Extension)" />
    <Compile Include="../../examples/AnimatedTiles/AnimatedTileScene.cs;../../examples/AnimatedTiles/AnimatedTileAssets.cs" Link="Examples/AnimatedTiles/%(Filename)%(Extension)" />
    <Compile Include="../../examples/TileRoutes/TileRouteScene.cs;../../examples/TileRoutes/TileRouteAssets.cs" Link="Examples/TileRoutes/%(Filename)%(Extension)" />
    <Compile Include="../../examples/SceneTiles/SceneTileAssets.cs" Link="Examples/SceneTiles/SceneTileAssets.cs" />
    <Compile Include="../../examples/BakedRoutes/RouteScene.cs;../../examples/BakedRoutes/RouteAssets.cs" Link="Examples/BakedRoutes/%(Filename)%(Extension)" />
    <Compile Include="../../examples/AsyncGallery/Gallery.cs;../../examples/AsyncGallery/GalleryAssets.cs" Link="Examples/AsyncGallery/%(Filename)%(Extension)" />
    <Compile Include="../../examples/PhysicsNetwork/*.cs" Exclude="../../examples/PhysicsNetwork/Program.cs" Link="Examples/PhysicsNetwork/%(Filename)%(Extension)" />
