    <EmbeddedResource Include="Fixtures/Audio/Limiter/reference.json" LogicalName="TestAudio.LimiterReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/Compressor/reference.json" LogicalName="TestAudio.CompressorReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/PitchShift/reference.json" LogicalName="TestAudio.PitchShiftReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/Phaser/reference.json" LogicalName="TestAudio.PhaserReference.json" />
    <EmbeddedResource Include="Fixtures/Tiles/*.json" LogicalName="TestTiles.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/Navigation/*.json" LogicalName="TestNavigation.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/Fonts/*.woff2;Fixtures/Fonts/*.ttf;Fixtures/Fonts/*.ttc;Fixtures/Fonts/*.otf;Fixtures/Fonts/*.pfb;Fixtures/Fonts/*.pfa;Fixtures/Fonts/*.pfm;Fixtures/Fonts/*.afm" LogicalName="TestFonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="../../tools/native-consumer.props" />
  <ItemGroup><Electron2DComputeShader Include="Shaders/LocalSpecialization.comp.glsl;Shaders/LocalSpecializationLayout.comp.glsl;Shaders/LocalPushCapacity.comp.glsl;Shaders/LocalPushOverCapacity.comp.glsl;Shaders/LocalPushGLSL.comp.glsl;Shaders/LocalPushHLSL.comp.hlsl;Shaders/LocalDepthGLSL.comp.glsl;Shaders/LocalDepthHLSL.comp.hlsl;Shaders/LocalCompute.comp.glsl;Shaders/LocalComputeHLSL.comp.hlsl;Shaders/IndirectArguments.comp.glsl;Shaders/DeviceArguments.comp.glsl;Shaders/LocalTextureInteger.comp.glsl;Shaders/LocalTextureModes.comp.glsl;Shaders/LocalTexture.comp.glsl;Shaders/LocalTextureHLSL.comp.hlsl" /></ItemGroup>
  <Import Project="../../tools/shaders/ComputeShaders.targets" />
  <ItemGroup><Electron2DDeviceShader Include="Shaders/MeshImporterGLSL.frag.glsl;Shaders/MeshImporterHLSL.frag.hlsl;Shaders/MeshCompressionGLSL.frag.glsl;Shaders/MeshCompressionHLSL.frag.hlsl;Shaders/MeshCustomGLSL.frag.glsl;Shaders/MeshCustomHLSL.frag.hlsl;Shaders/MeshFrameGLSL.frag.glsl;Shaders/MeshFrameHLSL.frag.hlsl;Shaders/MeshUV2GLSL.frag.glsl;Shaders/MeshUV2HLSL.frag.hlsl;Shaders/Device*.vert.glsl;Shaders/Device*.frag.glsl;Shaders/Device*.vert.hlsl;Shaders/Device*.frag.hlsl" /></ItemGroup>
  <Import Project="../../tools/shaders/DeviceShaders.targets" />
  <ItemGroup><Electron2DComputeShader Include="../../examples/WaterPlayground/Water.comp.glsl" /></ItemGroup>
</Project>
