<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Electron2D.csproj" />
    <EmbeddedResource Include="Shaders/*.spv" LogicalName="TestShaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/StyleBoxFlatGeometry.json" LogicalName="TestFixtures.StyleBoxFlatGeometry.json" />
    <EmbeddedResource Include="Fixtures/UnicodeTextConformance.json" LogicalName="TestFixtures.UnicodeTextConformance.json" />
    <EmbeddedResource Include="Fixtures/Audio/*.mp3;Fixtures/Audio/*.ogg;Fixtures/Audio/*.f32" LogicalName="TestAudio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/Audio/Filters/reference.json" LogicalName="TestAudio.FilterReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/EQ/reference.json" LogicalName="TestAudio.EQReference.json" />
    <EmbeddedResource Include="Fixtures/Fonts/*.woff2;Fixtures/Fonts/*.ttf" LogicalName="TestFonts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
