    <Compile Include="../../editor/EditorScene.cs" Link="Editor/EditorScene.cs" />
    <Compile Include="../../examples/CharacterMovement/CharacterMovementScene.cs" Link="Examples/CharacterMovementScene.cs" />
    <Compile Include="../../examples/CharacterMovement/Player.cs" Link="Examples/Player.cs" />
    <Content Include="../../docs/design/assets/sprite/sparkle.svg" Link="Assets/sparkle.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/design/assets/sprite/mark-dark.svg" Link="Assets/mark-dark.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/design/assets/sprite/app-icon.svg" Link="Assets/app-icon.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../editor/Assets/IBMPlexSans-Regular.ttf" Link="Assets/IBMPlexSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
