<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredCompilation Condition="'$(Configuration)' == 'Release'">false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" PrivateAssets="all" Publish="true" />
    <ProjectReference Include="../../Electron2D.csproj" />
    <Compile Include="../../examples/PhysicsSandbox/SandboxWindow.cs;../../examples/PhysicsSandbox/PhysicsScene.cs;../../examples/PhysicsSandbox/PhysicsScene.Stories.cs;../../examples/PhysicsSandbox/PhysicsScene.Games.cs;../../examples/PhysicsSandbox/SandboxWindow.Parameters.cs" Link="Examples/%(Filename)%(Extension)" />
    <Compile Include="../../editor/EditorScene.cs" Link="Editor/EditorScene.cs" />
    <Compile Include="../../examples/CharacterMovement/CharacterMovementScene.cs" Link="Examples/CharacterMovementScene.cs" />
    <Compile Include="../../examples/CharacterMovement/Player.cs" Link="Examples/Player.cs" />
    <Content Include="../../docs/design/assets/sprite/sparkle.svg" Link="Assets/sparkle.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/design/assets/sprite/mark-dark.svg" Link="Assets/mark-dark.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/design/assets/sprite/app-icon.svg" Link="Assets/app-icon.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../editor/Assets/IBMPlexSans-Regular.ttf" Link="Assets/IBMPlexSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../editor/Assets/IBMPlexSans-SemiBold.ttf" Link="Assets/IBMPlexSans-SemiBold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Shaders/*.spv" LogicalName="TestShaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/StyleBoxFlatGeometry.json" LogicalName="TestFixtures.StyleBoxFlatGeometry.json" />
    <EmbeddedResource Include="Fixtures/UnicodeTextConformance.json" LogicalName="TestFixtures.UnicodeTextConformance.json" />
    <EmbeddedResource Include="Fixtures/Audio/*.mp3;Fixtures/Audio/*.ogg;Fixtures/Audio/*.f32" LogicalName="TestAudio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/Audio/Filters/reference.json" LogicalName="TestAudio.FilterReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/EQ/reference.json" LogicalName="TestAudio.EQReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/Reverb/reference.json" LogicalName="TestAudio.ReverbReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/Distortion/reference.json" LogicalName="TestAudio.DistortionReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/HardLimiter/reference.json" LogicalName="TestAudio.HardLimiterReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/Limiter/reference.json" LogicalName="TestAudio.LimiterReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/Compressor/reference.json" LogicalName="TestAudio.CompressorReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/PitchShift/reference.json" LogicalName="TestAudio.PitchShiftReference.json" />
    <EmbeddedResource Include="Fixtures/Audio/Phaser/reference.json" LogicalName="TestAudio.PhaserReference.json" />
    <EmbeddedResource Include="Fixtures/Fonts/*.woff2;Fixtures/Fonts/*.ttf;Fixtures/Fonts/*.ttc" LogicalName="TestFonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="../../tools/native-consumer.props" />
</Project>
