find_package(Python3 REQUIRED COMPONENTS Interpreter)

function(e2d_prepare_shaping target source epoch)
    set(generator "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/prepare.py")
    set(owned "${CMAKE_CURRENT_BINARY_DIR}/owned-harfbuzz-src")
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${generator}" "${source}/src" "${owned}" "${epoch}"
        COMMAND_ERROR_IS_FATAL ANY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${generator}" "${source}/src/hb-machinery.hh")
    get_target_property(sources ${target} SOURCES)
    set(prepared)
    set(count 0)
    foreach(file IN LISTS sources)
        set(destination "${file}")
        string(FIND "${file}" "${source}/src/" prefix)
        if(prefix EQUAL 0)
            file(RELATIVE_PATH relative "${source}/src" "${file}")
            if(EXISTS "${owned}/${relative}")
                set(destination "${owned}/${relative}")
                if(relative MATCHES "\\.cc$")
                    math(EXPR count "${count} + 1")
                endif()
                foreach(property COMPILE_FLAGS COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES LANGUAGE SKIP_PRECOMPILE_HEADERS OBJECT_DEPENDS)
                    get_source_file_property(value "${file}" ${property})
                    if(NOT value STREQUAL "NOTFOUND")
                        set_source_files_properties("${destination}" PROPERTIES ${property} "${value}")
                    endif()
                endforeach()
            endif()
        endif()
        list(APPEND prepared "${destination}")
    endforeach()
    if(count EQUAL 0)
        message(FATAL_ERROR "The pinned shaping target no longer compiles its source tree")
    endif()
    set_property(TARGET ${target} PROPERTY SOURCES "${prepared}")
    target_include_directories(${target} BEFORE PRIVATE "${owned}")
endfunction()
