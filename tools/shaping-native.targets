<Project>
  <PropertyGroup>
    <_Electron2DShapingBuild>$(MSBuildThisFileDirectory)../obj/shaping-native/$(Electron2DNativePackageVersion)/$(_Electron2DPrivateNativeRID)</_Electron2DShapingBuild>
    <_Electron2DShapingName>libHarfBuzzSharp.so</_Electron2DShapingName>
    <_Electron2DShapingName Condition="'$(Electron2DNativePlatform)' == 'MacOS'">libHarfBuzzSharp.dylib</_Electron2DShapingName>
    <_Electron2DShapingLibrary>$(_Electron2DShapingBuild)/$(_Electron2DShapingName)</_Electron2DShapingLibrary>
    <_Electron2DShapingLibrary Condition="'$(Electron2DBuildNativeFromSource)' != 'true' and '$(Electron2DNativePlatform)' == 'Linux'">$(PkgElectron2D_Linux)/runtimes/$(_Electron2DPrivateNativeRID)/native/$(_Electron2DShapingName)</_Electron2DShapingLibrary>
    <_Electron2DShapingLibrary Condition="'$(Electron2DBuildNativeFromSource)' != 'true' and '$(Electron2DNativePlatform)' == 'MacOS'">$(PkgElectron2D_MacOS)/runtimes/$(_Electron2DPrivateNativeRID)/native/$(_Electron2DShapingName)</_Electron2DShapingLibrary>
    <Electron2DHarfBuzzNativeLibrary Condition="'$(Electron2DHarfBuzzNativeLibrary)' == ''">$(_Electron2DShapingLibrary)</Electron2DHarfBuzzNativeLibrary>
    <_Electron2DShapingLibrary>$(Electron2DHarfBuzzNativeLibrary)</_Electron2DShapingLibrary>
  </PropertyGroup>
  <ItemGroup Condition="'$(Electron2DNativePlatform)' == 'Linux' or '$(Electron2DNativePlatform)' == 'MacOS'">
    <None Include="$(_Electron2DShapingLibrary)" Link="runtimes/$(_Electron2DPrivateNativeRID)/native/$(_Electron2DShapingName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" Visible="false" />
  </ItemGroup>
  <Target Name="BuildElectron2DShapingNative" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems;ComputeFilesToPublish" DependsOnTargets="BuildElectron2DENetNative" Condition="'$(Electron2DBuildNativeFromSource)' == 'true' and ('$(Electron2DNativePlatform)' == 'Linux' or '$(Electron2DNativePlatform)' == 'MacOS')" Inputs="$(MSBuildThisFileDirectory)shaping-native/CMakeLists.txt;$(MSBuildThisFileDirectory)font-native/verify-source.cmake;$(MSBuildThisFileDirectory)shaping-native/allocator.cc;$(MSBuildThisFileDirectory)shaping-native/prepare.py;$(MSBuildThisFileDirectory)shaping-native/prepare.cmake;$(MSBuildThisFileDirectory)native/harfbuzz.cmake;$(_Electron2DENetLibrary);$(MSBuildThisFileFullPath)" Outputs="$(_Electron2DShapingLibrary)">
    <Error Condition="'$(_Electron2DPrivateNativeRID)' != '$(NETCoreSdkRuntimeIdentifier)'" Text="Shaping requires a matching target-native build host." />
    <Exec Command="cmake -S &quot;$(MSBuildThisFileDirectory)shaping-native&quot; -B &quot;$(_Electron2DShapingBuild)&quot; -G Ninja -DCMAKE_BUILD_TYPE=Release -DELECTRON2D_MEMORY_LIBRARY=&quot;$(_Electron2DENetLibrary)&quot;" />
    <Exec Command="cmake --build &quot;$(_Electron2DShapingBuild)&quot; --target harfbuzz --parallel 2" />
  </Target>
</Project>
