function(e2d_webp_replace target original replacement)
  get_target_property(sources ${target} SOURCES)
  list(FIND sources "${electron2dwebpcodec_SOURCE_DIR}/${original}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Pinned WebP target no longer owns ${original}: ${target}")
  endif()
  list(REMOVE_AT sources ${position})
  list(APPEND sources "${replacement}")
  set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
  target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_LIST_DIR}")
endfunction()

# Generate only the two allocator-owning files; leave downloaded inputs pristine.
set(webp_memory_dir "${CMAKE_CURRENT_BINARY_DIR}/memory-sources")
file(MAKE_DIRECTORY "${webp_memory_dir}")
foreach(pair IN ITEMS "src/utils/utils.c|c8d90b4ccd536136ac710321c2632912a1f6ee2492a423e14ab9deb159490a56" "sharpyuv/sharpyuv.c|c4dc476dae840f1b5e05464013e801b9c40dc26854e0223211ee927a7df65fa6")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 original)
  list(GET pair 1 expected)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${electron2dwebpcodec_SOURCE_DIR}/${original}")
  file(SHA256 "${electron2dwebpcodec_SOURCE_DIR}/${original}" digest)
  if(NOT digest STREQUAL expected)
    message(FATAL_ERROR "Pinned WebP allocator input changed: ${original}")
  endif()
  file(READ "${electron2dwebpcodec_SOURCE_DIR}/${original}" source)
  if(original STREQUAL "src/utils/utils.c")
    string(REPLACE "ptr = malloc((size_t)(nmemb * size));" "ptr = e2d_webp_allocate((size_t)(nmemb * size));" source "${source}")
    string(REPLACE "ptr = calloc((size_t)nmemb, size);" "ptr = e2d_webp_zero((size_t)nmemb, size);" source "${source}")
    string(REPLACE "  free(ptr);" "  e2d_webp_release(ptr);" source "${source}")
    set(targets webputils webputilsdecode)
  else()
    string(REPLACE "return malloc((size_t)total_size);" "return e2d_webp_allocate((size_t)total_size);" source "${source}")
    string(REPLACE "  free(" "  e2d_webp_release(" source "${source}")
    set(targets sharpyuv)
  endif()
  get_filename_component(name "${original}" NAME)
  file(WRITE "${webp_memory_dir}/${name}" "#include \"webp_memory.h\"\n${source}")
  foreach(target IN LISTS targets)
    e2d_webp_replace(${target} "${original}" "${webp_memory_dir}/${name}")
  endforeach()
endforeach()
