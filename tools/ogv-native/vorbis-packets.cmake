# Header copies and every retirement site must use the same original allocator.
set(vorbis_packet_inputs
  "info|03af6059fe7e50d0b37a0370707139227e6cd4cc74be56473cd22f0300739fca"
  "block|7f65c7031c2b94405d2c1b5f0a73cc19efe9506e95736ba0b38d86bd42170a7e")
foreach(input IN LISTS vorbis_packet_inputs)
  string(REPLACE "|" ";" input "${input}")
  list(GET input 0 name)
  list(GET input 1 expected)
  set(source "${electron2dvorbis_SOURCE_DIR}/lib/${name}.c")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  file(SHA256 "${source}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Re-audit Vorbis packet publication when updating libvorbis: ${name}")
  endif()
  list(FIND vorbis_files "${source}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Pinned Vorbis target no longer owns lib/${name}.c")
  endif()
endforeach()
file(READ "${electron2dvorbis_SOURCE_DIR}/lib/info.c" info_text)
string(REPLACE "if(_vorbis_pack_comment(&opb,vc)){" "if(oggpack_writecheck(&opb)||_vorbis_pack_comment(&opb,vc)||oggpack_writecheck(&opb)){" info_text "${info_text}")
foreach(kind info comment books)
  if(kind STREQUAL "comment")
    set(argument vc)
  else()
    set(argument vi)
  endif()
  string(REPLACE "if(_vorbis_pack_${kind}(&opb,${argument}))goto err_out;"
    "if(oggpack_writecheck(&opb)||_vorbis_pack_${kind}(&opb,${argument})||oggpack_writecheck(&opb))goto err_out;" info_text "${info_text}")
endforeach()
string(REPLACE "  memcpy(op->packet, opb.buffer, oggpack_bytes(&opb));"
  "  if(!op->packet){oggpack_writeclear(&opb);return OV_EFAULT;}\n  memcpy(op->packet, opb.buffer, oggpack_bytes(&opb));" info_text "${info_text}")
# This standalone packet is released by Ogg.
string(REPLACE "op->packet = _ogg_malloc(oggpack_bytes(&opb));"
  "op->packet = e2d_ogv_allocate(oggpack_bytes(&opb));" info_text "${info_text}")
foreach(header header header1 header2)
  string(REPLACE "b->${header}=_ogg_malloc(oggpack_bytes(&opb));"
    "b->${header}=e2d_ogv_allocate(oggpack_bytes(&opb));" info_text "${info_text}")
  string(REPLACE "  memcpy(b->${header},opb.buffer,oggpack_bytes(&opb));"
    "  if(!b->${header}){ret=OV_EFAULT;goto err_out;}\n  memcpy(b->${header},opb.buffer,oggpack_bytes(&opb));" info_text "${info_text}")
endforeach()
file(READ "${electron2dvorbis_SOURCE_DIR}/lib/block.c" block_text)
foreach(name info block)
  foreach(header header header1 header2)
    string(REPLACE "_ogg_free(b->${header})" "e2d_ogv_release(b->${header})" ${name}_text "${${name}_text}")
  endforeach()
  list(REMOVE_ITEM vorbis_files "${electron2dvorbis_SOURCE_DIR}/lib/${name}.c")
  list(APPEND vorbis_files "${CMAKE_CURRENT_BINARY_DIR}/${name}-memory.c")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${name}-memory.c" "#include \"memory.h\"\n${${name}_text}")
endforeach()
