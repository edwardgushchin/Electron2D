# Keep both allocator inputs pristine and validate the complete target before copying.
set(ogg_memory_inputs
  "framing|04373c7f155e0f6d8a5f355108b2908002a6ffe3895da89796619090a3313bdc"
  "bitwise|753d2ace9337bcb8c9ef23f42d630186f55f75a0d962ee79b3e7d87a614c147c")
get_target_property(ogg_sources ogg SOURCES)
foreach(input IN LISTS ogg_memory_inputs)
  string(REPLACE "|" ";" input "${input}")
  list(GET input 0 name)
  list(GET input 1 expected)
  set(source "${electron2dogg_SOURCE_DIR}/src/${name}.c")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  file(SHA256 "${source}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Re-audit Ogg allocation when updating libogg: ${name}")
  endif()
  list(FIND ogg_sources "src/${name}.c" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Pinned Ogg target no longer owns src/${name}.c")
  endif()
endforeach()
foreach(input IN LISTS ogg_memory_inputs)
  string(REPLACE "|" ";" input "${input}")
  list(GET input 0 name)
  file(READ "${electron2dogg_SOURCE_DIR}/src/${name}.c" text)
  foreach(pair IN ITEMS "malloc|allocate" "calloc|zero" "realloc|resize" "free|release")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 original)
    list(GET pair 1 replacement)
    string(REPLACE "_ogg_${original}" "e2d_ogv_${replacement}" text "${text}")
  endforeach()
  if(name STREQUAL "bitwise")
    # unsigned long is 32 bits on supported Windows targets, including zero-bit writes.
    string(REPLACE "value=(value&mask[bits])<<(32-bits);" "value=bits ? (value&mask[bits])<<(32-bits) : 0;" text "${text}")
  endif()
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${name}-memory.c" "#include \"memory.h\"\n${text}")
  list(REMOVE_ITEM ogg_sources "src/${name}.c")
  list(APPEND ogg_sources "${CMAKE_CURRENT_BINARY_DIR}/${name}-memory.c")
endforeach()
set_property(TARGET ogg PROPERTY SOURCES "${ogg_sources}")
target_include_directories(ogg PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${electron2dogg_SOURCE_DIR}/src")
