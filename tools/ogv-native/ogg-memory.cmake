# Route the container's original allocator without changing codec bit buffers.
set(framing "${electron2dogg_SOURCE_DIR}/src/framing.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${framing}")
file(SHA256 "${framing}" framing_hash)
if(NOT framing_hash STREQUAL "04373c7f155e0f6d8a5f355108b2908002a6ffe3895da89796619090a3313bdc")
  message(FATAL_ERROR "Re-audit Ogg container allocation when updating libogg.")
endif()
file(READ "${framing}" framing_text)
foreach(pair IN ITEMS "malloc|allocate" "calloc|zero" "realloc|resize" "free|release")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 original)
  list(GET pair 1 replacement)
  string(REPLACE "_ogg_${original}" "e2d_ogv_${replacement}" framing_text "${framing_text}")
endforeach()
get_target_property(ogg_sources ogg SOURCES)
list(FIND ogg_sources "src/framing.c" framing_position)
if(framing_position EQUAL -1)
  message(FATAL_ERROR "Pinned Ogg target no longer owns src/framing.c")
endif()
list(REMOVE_AT ogg_sources ${framing_position})
list(APPEND ogg_sources "${CMAKE_CURRENT_BINARY_DIR}/framing-memory.c")
set_property(TARGET ogg PROPERTY SOURCES "${ogg_sources}")
target_include_directories(ogg PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${electron2dogg_SOURCE_DIR}/src")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/framing-memory.c" "#include \"memory.h\"\n${framing_text}")
