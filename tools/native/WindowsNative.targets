<Project>
  <PropertyGroup>
    <_Electron2DWindowsRID Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_Electron2DWindowsRID>
    <_Electron2DWindowsRID Condition="'$(_Electron2DWindowsRID)' == ''">$(NETCoreSdkRuntimeIdentifier)</_Electron2DWindowsRID>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only retired engine payloads are removed; application and third-party files stay intact. -->
    <_Electron2DLegacyWindowsFile Include="Electron2DENet.dll;Electron2DKTX.dll;Electron2DMesh.dll;Electron2DOGV.dll;Electron2DTextBreak.dll;Electron2DWebP.dll;Electron2DWebRTC.dll;Electron2DRender.dll;Electron2DFreeType.dll;libHarfBuzzSharp.dll;libHarfBuzzSharp.pdb;libcrypto-3-Electron2D.dll;libssl-3-Electron2D.dll;libcrypto-4-Electron2D.dll;libssl-4-Electron2D.dll" />
  </ItemGroup>
  <Target Name="RejectElectron2DLegacyWindowsPackage" AfterTargets="ResolvePackageAssets" Condition="$([System.String]::Copy('$(_Electron2DWindowsRID)').StartsWith('win-'))">
    <ItemGroup>
      <_Electron2DWindowsPackageAsset Include="@(NativeCopyLocalItems);@(RuntimeTargetsCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'Electron2D.Windows'" />
      <_Electron2DLegacyWindowsAsset Include="@(_Electron2DWindowsPackageAsset)" Condition="'%(Filename)%(Extension)' == 'Electron2DENet.dll' or '%(Filename)%(Extension)' == 'Electron2DFreeType.dll' or '%(Filename)%(Extension)' == 'libHarfBuzzSharp.dll' or '%(Filename)%(Extension)' == 'libcrypto-3-Electron2D.dll' or '%(Filename)%(Extension)' == 'libcrypto-4-Electron2D.dll'" />
    </ItemGroup>
    <Error Condition="'@(_Electron2DLegacyWindowsAsset)' != ''" Text="Electron2D.Windows contains retired native modules. Restore a qualified package with libElectron2D.dll, freetype.dll, harfbuzz.dll and the OpenSSL 4 pair; deleting output files cannot upgrade this package." />
  </Target>
  <Target Name="Electron2DWindowsNativePublishCopy" BeforeTargets="_ComputeResolvedFilesToPublishTypes" Condition="$([System.String]::Copy('$(_Electron2DWindowsRID)').StartsWith('win-'))">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'Electron2D.Windows' and '%(ResolvedFileToPublish.AssetType)' == 'native'">
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <_Electron2DLegacyWindowsPublishPath Include="@(_Electron2DLegacyWindowsFile);@(_Electron2DLegacyWindowsFile->'runtimes/$(_Electron2DWindowsRID)/native/%(Identity)')" />
      <_Electron2DLegacyWindowsPublishPath Update="@(_Electron2DLegacyWindowsPublishPath)">
        <RelativePath>%(Identity)</RelativePath>
      </_Electron2DLegacyWindowsPublishPath>
      <_Electron2DUnrelatedPublishFile Include="@(ResolvedFileToPublish)" />
      <_Electron2DUnrelatedPublishFile Remove="@(_Electron2DLegacyWindowsPublishPath)" MatchOnMetadata="RelativePath" MatchOnMetadataOptions="PathLike" />
      <_Electron2DApplicationNativePublishFile Include="@(ResolvedFileToPublish)" />
      <_Electron2DApplicationNativePublishFile Remove="@(_Electron2DUnrelatedPublishFile)" MatchOnMetadata="RelativePath" MatchOnMetadataOptions="PathLike" />
      <ResolvedFileToPublish Update="@(_Electron2DApplicationNativePublishFile)">
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="CleanElectron2DLegacyWindowsBuild" AfterTargets="CopyFilesToOutputDirectory" Condition="$([System.String]::Copy('$(_Electron2DWindowsRID)').StartsWith('win-')) and '$(TargetDir)' != ''">
    <ItemGroup>
      <_Electron2DLegacyWindowsBuildPath Include="@(_Electron2DLegacyWindowsFile);@(_Electron2DLegacyWindowsFile->'runtimes/$(_Electron2DWindowsRID)/native/%(Identity)')" />
      <_Electron2DLegacyWindowsBuildPath Update="@(_Electron2DLegacyWindowsBuildPath)">
        <TargetPath>%(Identity)</TargetPath>
      </_Electron2DLegacyWindowsBuildPath>
      <_Electron2DReferenceBuildSource Include="@(ReferenceCopyLocalPaths)" Condition="'$(UseCommonOutputDirectory)' != 'true'">
        <TargetPath>%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</TargetPath>
      </_Electron2DReferenceBuildSource>
      <!-- The SDK copies project items after references, so project sources own overlapping paths. -->
      <_Electron2DReferenceBuildSource Remove="@(AllItemsFullPathWithTargetPath)" MatchOnMetadata="TargetPath" MatchOnMetadataOptions="PathLike" />
      <_Electron2DBuildSource Include="@(_Electron2DReferenceBuildSource);@(AllItemsFullPathWithTargetPath)" />
      <_Electron2DUnrelatedBuildSource Include="@(_Electron2DBuildSource)" />
      <_Electron2DUnrelatedBuildSource Remove="@(_Electron2DLegacyWindowsBuildPath)" MatchOnMetadata="TargetPath" MatchOnMetadataOptions="PathLike" />
      <_Electron2DApplicationNativeBuildFile Include="@(_Electron2DBuildSource)" />
      <_Electron2DApplicationNativeBuildFile Remove="@(_Electron2DUnrelatedBuildSource)" MatchOnMetadata="TargetPath" MatchOnMetadataOptions="PathLike" />
      <_Electron2DLegacyWindowsBuildFile Include="@(_Electron2DLegacyWindowsBuildPath)" />
      <_Electron2DLegacyWindowsBuildFile Remove="@(_Electron2DApplicationNativeBuildFile)" MatchOnMetadata="TargetPath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <Delete Files="@(_Electron2DLegacyWindowsBuildFile->'$(TargetDir)%(TargetPath)')" />
    <Copy SourceFiles="@(_Electron2DApplicationNativeBuildFile)" DestinationFiles="@(_Electron2DApplicationNativeBuildFile->'$(TargetDir)%(TargetPath)')" SkipUnchangedFiles="false" Condition="'@(_Electron2DApplicationNativeBuildFile)' != ''">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <GetFileHash Files="@(_Electron2DApplicationNativeBuildFile)" Algorithm="SHA256" Condition="'@(_Electron2DApplicationNativeBuildFile)' != ''">
      <Output TaskParameter="Items" ItemName="_Electron2DApplicationNativeBuildHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(TargetDir)Electron2D.application-native.sha256" Lines="@(_Electron2DApplicationNativeBuildHash->'%(FileHash)  %(TargetPath)')" Overwrite="true" Encoding="UTF-8" Condition="'@(_Electron2DApplicationNativeBuildFile)' != ''" />
    <Delete Files="$(TargetDir)Electron2D.application-native.sha256" Condition="'@(_Electron2DApplicationNativeBuildFile)' == ''" />
    <ItemGroup Condition="'@(_Electron2DApplicationNativeBuildFile)' != ''">
      <FileWrites Include="$(TargetDir)Electron2D.application-native.sha256" />
    </ItemGroup>
  </Target>
  <Target Name="CleanElectron2DLegacyWindowsPublish" AfterTargets="Publish" Condition="$([System.String]::Copy('$(_Electron2DWindowsRID)').StartsWith('win-')) and '$(PublishDir)' != ''">
    <ItemGroup>
      <_Electron2DLegacyWindowsPublishFile Include="@(_Electron2DLegacyWindowsPublishPath)" />
      <_Electron2DLegacyWindowsPublishFile Remove="@(ResolvedFileToPublish)" MatchOnMetadata="RelativePath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <Delete Files="@(_Electron2DLegacyWindowsPublishFile->'$(PublishDir)%(RelativePath)')" />
    <GetFileHash Files="@(_Electron2DApplicationNativePublishFile)" Algorithm="SHA256" Condition="'@(_Electron2DApplicationNativePublishFile)' != ''">
      <Output TaskParameter="Items" ItemName="_Electron2DApplicationNativePublishHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(PublishDir)Electron2D.application-native.sha256" Lines="@(_Electron2DApplicationNativePublishHash->'%(FileHash)  %(RelativePath)')" Overwrite="true" Encoding="UTF-8" Condition="'@(_Electron2DApplicationNativePublishFile)' != ''" />
    <Delete Files="$(PublishDir)Electron2D.application-native.sha256" Condition="'@(_Electron2DApplicationNativePublishFile)' == ''" />
  </Target>
</Project>
