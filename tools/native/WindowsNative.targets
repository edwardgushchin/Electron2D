<Project>
  <PropertyGroup>
    <_Electron2DWindowsRID Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_Electron2DWindowsRID>
    <_Electron2DWindowsRID Condition="'$(_Electron2DWindowsRID)' == ''">$(NETCoreSdkRuntimeIdentifier)</_Electron2DWindowsRID>
  </PropertyGroup>
  <ItemGroup>
    <_Electron2DLegacyWindowsFile Include="Electron2DENet.dll;Electron2DKTX.dll;Electron2DMesh.dll;Electron2DOGV.dll;Electron2DTextBreak.dll;Electron2DWebP.dll;Electron2DWebRTC.dll;Electron2DRender.dll;Electron2DFreeType.dll;libHarfBuzzSharp.dll;libHarfBuzzSharp.pdb;libcrypto-3-Electron2D.dll;libssl-3-Electron2D.dll;libcrypto-4-Electron2D.dll;libssl-4-Electron2D.dll" />
    <_Electron2DWindowsCleanupFile Include="@(_Electron2DLegacyWindowsFile);libElectron2D.dll" />
  </ItemGroup>
  <Target Name="RejectElectron2DLegacyWindowsPackage" AfterTargets="ResolvePackageAssets" Condition="$([System.String]::Copy('$(_Electron2DWindowsRID)').StartsWith('win-'))">
    <ItemGroup>
      <_Electron2DWindowsPackageAsset Include="@(NativeCopyLocalItems);@(RuntimeTargetsCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'Electron2D.Windows'" />
      <_Electron2DWindowsCleanupAsset Include="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Electron2D.Windows' or $([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').StartsWith('SDL3-CS.Windows'))" />
      <_Electron2DWindowsCleanupAsset Include="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native' and ('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Electron2D.Windows' or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('SDL3-CS.Windows')))" />
      <_Electron2DWindowsCleanupFile Include="@(_Electron2DWindowsCleanupAsset->'%(Filename)%(Extension)')" />
      <_Electron2DLegacyWindowsAsset Include="@(_Electron2DWindowsPackageAsset)" Condition="'%(Filename)%(Extension)' == 'Electron2DENet.dll' or '%(Filename)%(Extension)' == 'Electron2DFreeType.dll' or '%(Filename)%(Extension)' == 'libHarfBuzzSharp.dll' or '%(Filename)%(Extension)' == 'libcrypto-3-Electron2D.dll' or '%(Filename)%(Extension)' == 'libcrypto-4-Electron2D.dll'" />
    </ItemGroup>
    <Error Condition="'@(_Electron2DLegacyWindowsAsset)' != ''" Text="Electron2D.Windows contains retired native modules. Restore a qualified package with libElectron2D.dll, freetype.dll, harfbuzz.dll and the OpenSSL 4 pair; deleting output files cannot upgrade this package." />
  </Target>
  <Target Name="Electron2DWindowsNativePublishCopy" BeforeTargets="_ComputeResolvedFilesToPublishTypes" Condition="$([System.String]::Copy('$(_Electron2DWindowsRID)').StartsWith('win-'))">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'Electron2D.Windows' and '%(ResolvedFileToPublish.AssetType)' == 'native'">
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <!-- Clear previous outputs before the SDK applies timestamps and content-copy ordering. -->
  <Target Name="PrepareElectron2DLegacyWindowsBuild" BeforeTargets="_CopyFilesMarkedCopyLocal;_CopySourceItemsToOutputDirectory" DependsOnTargets="GetCopyToOutputDirectoryItems" Condition="$([System.String]::Copy('$(_Electron2DWindowsRID)').StartsWith('win-')) and '$(TargetDir)' != ''">
    <ItemGroup>
      <_Electron2DLegacyWindowsBuildFile Include="$(TargetDir)%(_Electron2DWindowsCleanupFile.Identity)" Condition="Exists('$(TargetDir)%(_Electron2DWindowsCleanupFile.Identity)')" />
      <_Electron2DLegacyWindowsBuildFile Include="$(TargetDir)runtimes/*/native/%(_Electron2DWindowsCleanupFile.Identity)" />
      <_Electron2DLegacyWindowsBuildFile Remove="@(ReferenceCopyLocalPaths);@(AllItemsFullPathWithTargetPath)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <Delete Files="@(_Electron2DLegacyWindowsBuildFile)" />
  </Target>
  <Target Name="RecordElectron2DWindowsBuildFiles" AfterTargets="CopyFilesToOutputDirectory" Condition="$([System.String]::Copy('$(_Electron2DWindowsRID)').StartsWith('win-')) and '$(TargetDir)' != ''">
    <ItemGroup>
      <_Electron2DApplicationNativeBuildFile Include="$(TargetDir)%(_Electron2DLegacyWindowsFile.Identity)" Condition="Exists('$(TargetDir)%(_Electron2DLegacyWindowsFile.Identity)')" />
      <_Electron2DApplicationNativeBuildFile Include="$(TargetDir)runtimes/*/native/%(_Electron2DLegacyWindowsFile.Identity)" />
      <_Electron2DApplicationNativeBuildFile Update="@(_Electron2DApplicationNativeBuildFile)">
        <RelativePath>$([MSBuild]::MakeRelative('$(TargetDir)', '%(_Electron2DApplicationNativeBuildFile.FullPath)'))</RelativePath>
      </_Electron2DApplicationNativeBuildFile>
    </ItemGroup>
    <GetFileHash Files="@(_Electron2DApplicationNativeBuildFile)" Algorithm="SHA256" Condition="'@(_Electron2DApplicationNativeBuildFile)' != ''">
      <Output TaskParameter="Items" ItemName="_Electron2DApplicationNativeBuildHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(TargetDir)Electron2D.application-native.sha256" Lines="@(_Electron2DApplicationNativeBuildHash->'%(FileHash)  %(RelativePath)')" Overwrite="true" Encoding="UTF-8" Condition="'@(_Electron2DApplicationNativeBuildFile)' != ''" />
    <Delete Files="$(TargetDir)Electron2D.application-native.sha256" Condition="'@(_Electron2DApplicationNativeBuildFile)' == ''" />
    <ItemGroup Condition="'@(_Electron2DApplicationNativeBuildFile)' != ''">
      <FileWrites Include="$(TargetDir)Electron2D.application-native.sha256" />
    </ItemGroup>
  </Target>
  <Target Name="PrepareElectron2DLegacyWindowsPublish" AfterTargets="_ComputeResolvedFilesToPublishTypes" Condition="$([System.String]::Copy('$(_Electron2DWindowsRID)').StartsWith('win-')) and '$(PublishDir)' != ''">
    <ItemGroup>
      <_Electron2DLegacyWindowsPublishFile Include="$(PublishDir)%(_Electron2DWindowsCleanupFile.Identity)" Condition="Exists('$(PublishDir)%(_Electron2DWindowsCleanupFile.Identity)')" />
      <_Electron2DLegacyWindowsPublishFile Include="$(PublishDir)runtimes/*/native/%(_Electron2DWindowsCleanupFile.Identity)" />
      <_Electron2DLegacyWindowsPublishFile Remove="@(ResolvedFileToPublish)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <Delete Files="@(_Electron2DLegacyWindowsPublishFile)" />
  </Target>
  <Target Name="RecordElectron2DWindowsPublishFiles" AfterTargets="Publish" Condition="$([System.String]::Copy('$(_Electron2DWindowsRID)').StartsWith('win-')) and '$(PublishDir)' != ''">
    <ItemGroup>
      <_Electron2DApplicationNativePublishFile Include="$(PublishDir)%(_Electron2DLegacyWindowsFile.Identity)" Condition="Exists('$(PublishDir)%(_Electron2DLegacyWindowsFile.Identity)')" />
      <_Electron2DApplicationNativePublishFile Include="$(PublishDir)runtimes/*/native/%(_Electron2DLegacyWindowsFile.Identity)" />
      <_Electron2DApplicationNativePublishFile Update="@(_Electron2DApplicationNativePublishFile)">
        <RelativePath>$([MSBuild]::MakeRelative('$(PublishDir)', '%(_Electron2DApplicationNativePublishFile.FullPath)'))</RelativePath>
      </_Electron2DApplicationNativePublishFile>
    </ItemGroup>
    <GetFileHash Files="@(_Electron2DApplicationNativePublishFile)" Algorithm="SHA256" Condition="'@(_Electron2DApplicationNativePublishFile)' != ''">
      <Output TaskParameter="Items" ItemName="_Electron2DApplicationNativePublishHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(PublishDir)Electron2D.application-native.sha256" Lines="@(_Electron2DApplicationNativePublishHash->'%(FileHash)  %(RelativePath)')" Overwrite="true" Encoding="UTF-8" Condition="'@(_Electron2DApplicationNativePublishFile)' != ''" />
    <Delete Files="$(PublishDir)Electron2D.application-native.sha256" Condition="'@(_Electron2DApplicationNativePublishFile)' == ''" />
  </Target>
</Project>
