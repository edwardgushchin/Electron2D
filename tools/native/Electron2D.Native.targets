<Project>
  <PropertyGroup>
    <_Electron2DNativeNoticeRID Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_Electron2DNativeNoticeRID>
    <_Electron2DNativeNoticeRID Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</_Electron2DNativeNoticeRID>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios' or '$(TargetPlatformIdentifier)' == 'tvos'">
    <NativeReference Include="$(MSBuildThisFileDirectory)../runtimes/$(RuntimeIdentifier)/native/*.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>true</SmartLink>
      <IsCxx>true</IsCxx>
    </NativeReference>
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="CoreBluetooth" />
  </ItemGroup>
  <Target Name="Electron2DAppleCodecIdentity" BeforeTargets="CoreCompile;_ExpandNativeReferences" Condition="('$(TargetPlatformIdentifier)' == 'ios' or '$(TargetPlatformIdentifier)' == 'tvos') and '$(_SDL3CSNativeImageAppleStaticLibDir)' != ''">
    <!-- FreeType and SDL_image share the audited PNG/zlib archives instead of force-loading two copies. -->
    <ItemGroup>
      <NativeReference Remove="$(_SDL3CSNativeImageAppleStaticLibDir)libpng16.a;$(_SDL3CSNativeImageAppleStaticLibDir)libz.a" />
    </ItemGroup>
  </Target>
  <ItemGroup Condition="('$(MSBuildThisFileName)' == 'Electron2D.Native.MacOS' and $([System.String]::Copy('$(_Electron2DNativeNoticeRID)').StartsWith('osx-'))) or ('$(MSBuildThisFileName)' == 'Electron2D.Native.Linux' and $([System.String]::Copy('$(_Electron2DNativeNoticeRID)').StartsWith('linux-'))) or ('$(MSBuildThisFileName)' == 'Electron2D.Native.Windows' and $([System.String]::Copy('$(_Electron2DNativeNoticeRID)').StartsWith('win-')))">
    <None Include="$(MSBuildThisFileDirectory)../licence/*" Link="licence/%(Filename)%(Extension)" CopyToPublishDirectory="Always" Pack="false" Visible="false" />
  </ItemGroup>
  <!-- Preserve the private library directory for project and package consumers. -->
  <Target Name="Electron2DAndroidSDLLayout" AfterTargets="ResolvePackageAssets" Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <ItemGroup>
      <!-- The SDL AAR supplies JNI and the core library together. -->
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'SDL3-CS.Android'" />
    </ItemGroup>
  </Target>
  <Target Name="Electron2DNativeBuildLayout" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Update="@(NativeCopyLocalItems)" Condition="$([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').StartsWith('Electron2D.Native.')) and '$(RuntimeIdentifier)' != ''">
        <DestinationSubDirectory>runtimes/$(RuntimeIdentifier)/native/</DestinationSubDirectory>
      </NativeCopyLocalItems>
    </ItemGroup>
  </Target>
  <Target Name="Electron2DNativePublishLayout" AfterTargets="_ResolveCopyLocalAssetsForPublish;_ComputeResolvedCopyLocalPublishAssets">
    <ItemGroup>
      <_ResolvedCopyLocalPublishAssets Update="@(_ResolvedCopyLocalPublishAssets)" Condition="$([System.String]::Copy('%(_ResolvedCopyLocalPublishAssets.NuGetPackageId)').StartsWith('Electron2D.Native.')) and '$(RuntimeIdentifier)' != ''">
        <DestinationSubDirectory>runtimes/$(RuntimeIdentifier)/native/</DestinationSubDirectory>
      </_ResolvedCopyLocalPublishAssets>
    </ItemGroup>
  </Target>
</Project>
