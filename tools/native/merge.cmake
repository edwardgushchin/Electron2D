# Keep the application-facing static archive self-contained without copying SDL/audio.
function(e2d_collect_archives target)
    if(NOT TARGET "${target}")
        return()
    endif()
    get_target_property(aliased "${target}" ALIASED_TARGET)
    if(aliased)
        set(target "${aliased}")
    endif()
    if(target MATCHES "^(zlibstatic|png_static|brotlidec|brotlicommon|harfbuzz|freetype|libzstd_static|webp|webpdemux|sharpyuv)$")
        return()
    endif()
    get_property(seen GLOBAL PROPERTY E2D_MERGE_SEEN)
    if("${target}" IN_LIST seen)
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY E2D_MERGE_SEEN "${target}")
    get_target_property(kind "${target}" TYPE)
    if(kind STREQUAL "STATIC_LIBRARY" OR kind STREQUAL "UNKNOWN_LIBRARY")
        set_property(GLOBAL APPEND PROPERTY E2D_MERGE_INPUTS "$<TARGET_FILE:${target}>")
        set_property(GLOBAL APPEND PROPERTY E2D_MERGE_TARGETS "${target}")
    endif()
    get_target_property(dependencies "${target}" LINK_LIBRARIES)
    foreach(dependency IN LISTS dependencies)
        if(dependency MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
            set(dependency "${CMAKE_MATCH_1}")
        endif()
        e2d_collect_archives("${dependency}")
    endforeach()
endfunction()
function(e2d_merge_archives target)
    foreach(component IN LISTS ARGN)
        e2d_collect_archives("${component}")
    endforeach()
    get_property(inputs GLOBAL PROPERTY E2D_MERGE_INPUTS)
    get_property(targets GLOBAL PROPERTY E2D_MERGE_TARGETS)
    add_dependencies(${target} ${targets})
    set(stamp "${CMAKE_CURRENT_BINARY_DIR}/native-closure.stamp")
    add_custom_command(OUTPUT "${stamp}" COMMAND "${CMAKE_COMMAND}" -E touch "${stamp}"
        DEPENDS ${inputs} ${targets} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/merge.py")
    target_sources(${target} PRIVATE "${stamp}")
    set_property(SOURCE unified.c APPEND PROPERTY OBJECT_DEPENDS "${stamp}")
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND "${Python3_EXECUTABLE}" -B "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/merge.py"
        "$<TARGET_FILE:${target}>" "${CMAKE_AR}" ${inputs}
        VERBATIM)
endfunction()
