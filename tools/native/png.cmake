if(TARGET png_static)
    return()
endif()

include(FetchContent)
include("${CMAKE_CURRENT_LIST_DIR}/../font-native/verify-source.cmake")
set(png_revision cd952f49f95bb27154ae77dbb103032d95f6e580)
if(FETCHCONTENT_SOURCE_DIR_PNG)
    verify_source(Png "${png_revision}" "${FETCHCONTENT_SOURCE_DIR_PNG}")
endif()
FetchContent_Declare(Png
    GIT_REPOSITORY https://github.com/pnggroup/libpng.git
    GIT_TAG ${png_revision})
set(PNG_SHARED OFF CACHE BOOL "" FORCE)
set(PNG_STATIC ON CACHE BOOL "" FORCE)
set(PNG_FRAMEWORK OFF CACHE BOOL "" FORCE)
set(PNG_TESTS OFF CACHE BOOL "" FORCE)
set(PNG_TOOLS OFF CACHE BOOL "" FORCE)
if(TARGET zlibstatic)
    if(NOT TARGET ZLIB::ZLIB)
        add_library(ZLIB::ZLIB ALIAS zlibstatic)
    endif()
    # libpng's own FindZLIB call also needs the headers for a source-built zlib.
    FetchContent_GetProperties(Zlib SOURCE_DIR zlib_source BINARY_DIR zlib_binary)
    configure_file("${zlib_source}/zlib.h" "${zlib_binary}/zlib.h" COPYONLY)
    set(ZLIB_LIBRARY zlibstatic CACHE STRING "" FORCE)
    set(ZLIB_INCLUDE_DIR "${zlib_binary}" CACHE PATH "" FORCE)
    set(ZLIB_INCLUDE_DIRS "${zlib_binary}")
endif()
function(e2d_fetch_png)
    set(SKIP_INSTALL_ALL ON)
    FetchContent_MakeAvailable(Png)
    verify_source(Png "${png_revision}" "${png_SOURCE_DIR}")
    set(png_SOURCE_DIR "${png_SOURCE_DIR}" PARENT_SCOPE)
    set(png_BINARY_DIR "${png_BINARY_DIR}" PARENT_SCOPE)
endfunction()
e2d_fetch_png()
