<Project>
  <PropertyGroup>
    <Electron2DAudioNativeRID Condition="'$(Electron2DAudioNativeRID)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</Electron2DAudioNativeRID>
    <Electron2DAudioNativeRID Condition="'$(Electron2DAudioNativeRID)' == ''">$(NETCoreSdkRuntimeIdentifier)</Electron2DAudioNativeRID>
    <_Electron2DAudioName>libFAudio.so.0</_Electron2DAudioName>
    <_Electron2DAudioSDL>$(PkgSDL3-CS_Linux)/runtimes/$(Electron2DAudioNativeRID)/native/libSDL3.so.0</_Electron2DAudioSDL>
    <_Electron2DAudioName Condition="'$(Electron2DNativePlatform)' == 'MacOS'">libFAudio.0.dylib</_Electron2DAudioName>
    <_Electron2DAudioSDL Condition="'$(Electron2DNativePlatform)' == 'MacOS'">$(PkgSDL3-CS_MacOS)/runtimes/$(Electron2DAudioNativeRID)/native/libSDL3.0.dylib</_Electron2DAudioSDL>
    <Electron2DAudioNativeLibrary Condition="'$(Electron2DBuildNativeFromSource)' != 'true' and '$(Electron2DAudioNativeLibrary)' == '' and '$(Electron2DNativePlatform)' != 'MacOS'">$(PkgElectron2D_Native_Linux)/runtimes/$(Electron2DAudioNativeRID)/native/libFAudio.so.0</Electron2DAudioNativeLibrary>
    <Electron2DAudioNativeLibrary Condition="'$(Electron2DBuildNativeFromSource)' != 'true' and '$(Electron2DAudioNativeLibrary)' == '' and '$(Electron2DNativePlatform)' == 'MacOS'">$(PkgElectron2D_Native_MacOS)/runtimes/$(Electron2DAudioNativeRID)/native/libFAudio.0.dylib</Electron2DAudioNativeLibrary>
    <Electron2DAudioNativeEnabled Condition="'$(Electron2DAudioNativeEnabled)' == '' and '$(Electron2DNativePlatform)' == 'Linux' and ('$(Electron2DAudioNativeRID)' == 'linux-x64' or '$(Electron2DAudioNativeRID)' == 'linux-arm64')">true</Electron2DAudioNativeEnabled>
    <Electron2DAudioNativeEnabled Condition="'$(Electron2DAudioNativeEnabled)' == '' and '$(Electron2DNativePlatform)' == 'MacOS' and ('$(Electron2DAudioNativeRID)' == 'osx-x64' or '$(Electron2DAudioNativeRID)' == 'osx-arm64')">true</Electron2DAudioNativeEnabled>
    <Electron2DAudioNativeEnabled Condition="'$(Electron2DAudioNativeEnabled)' == ''">false</Electron2DAudioNativeEnabled>
    <Electron2DAudioNativeJobs Condition="'$(Electron2DAudioNativeJobs)' == ''">4</Electron2DAudioNativeJobs>
    <_Electron2DAudioSource>$(MSBuildThisFileDirectory)../src/Vendor/FAudio</_Electron2DAudioSource>
    <_Electron2DAudioWrapper>$(MSBuildThisFileDirectory)audio-native</_Electron2DAudioWrapper>
    <_Electron2DAudioBuild>$(MSBuildThisFileDirectory)../obj/audio-native/$(Electron2DAudioNativeRID)</_Electron2DAudioBuild>
    <_Electron2DAudioLibrary>$(_Electron2DAudioBuild)/$(_Electron2DAudioName)</_Electron2DAudioLibrary>
    <_Electron2DAudioLibrary Condition="'$(Electron2DAudioNativeLibrary)' != ''">$(Electron2DAudioNativeLibrary)</_Electron2DAudioLibrary>
    <_Electron2DAudioToolchainArg Condition="'$(Electron2DAudioNativeToolchain)' != ''">-DCMAKE_TOOLCHAIN_FILE=&quot;$(Electron2DAudioNativeToolchain)&quot;</_Electron2DAudioToolchainArg>
  </PropertyGroup>
  <ItemGroup>
    <_Electron2DAudioInput Include="$(_Electron2DAudioSource)/**/*.c;$(_Electron2DAudioSource)/**/*.h;$(_Electron2DAudioSource)/**/CMakeLists.txt;$(_Electron2DAudioSource)/manifest.json;$(_Electron2DAudioWrapper)/**/*;$(MSBuildThisFileDirectory)native-package.props;$(MSBuildThisFileFullPath)" />
    <None Include="$(_Electron2DAudioLibrary)" Condition="'$(Electron2DAudioNativeEnabled)' == 'true'" Link="runtimes/$(Electron2DAudioNativeRID)/native/$(_Electron2DAudioName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="$(Electron2DBuildNativeFromSource)" PackagePath="runtimes/$(Electron2DAudioNativeRID)/native/" Visible="false" />
  </ItemGroup>
  <Target Name="ValidateElectron2DAudioNative" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems;ComputeFilesToPublish" Condition="'$(Electron2DAudioNativeEnabled)' == 'true'">
    <Error Condition="'$(Electron2DNativePlatform)' != 'Linux' and '$(Electron2DNativePlatform)' != 'MacOS'" Text="Native audio builds require Linux or MacOS; foreign profiles must not package host libraries." />
    <Error Condition="('$(Electron2DNativePlatform)' == 'Linux' and '$(Electron2DAudioNativeRID)' != 'linux-x64' and '$(Electron2DAudioNativeRID)' != 'linux-arm64') or ('$(Electron2DNativePlatform)' == 'MacOS' and '$(Electron2DAudioNativeRID)' != 'osx-x64' and '$(Electron2DAudioNativeRID)' != 'osx-arm64')" Text="The audio RID must match its selected Linux or MacOS native profile." />
    <Error Condition="'$(Electron2DAudioNativeLibrary)' != '' and !Exists('$(_Electron2DAudioLibrary)')" Text="Electron2DAudioNativeLibrary must name an existing target library." />
    <Error Condition="'$(Electron2DAudioNativeLibrary)' == '' and '$(Electron2DAudioNativeRID)' != '$(NETCoreSdkRuntimeIdentifier)' and '$(Electron2DAudioNativeToolchain)' == ''" Text="Cross-RID audio builds require a target CMake toolchain or prebuilt target library." />
    <Error Condition="'$(Electron2DAudioNativeLibrary)' == '' and '$(Electron2DAudioNativeToolchain)' == '' and (('$(Electron2DNativePlatform)' == 'Linux' and !$([MSBuild]::IsOSPlatform('Linux'))) or ('$(Electron2DNativePlatform)' == 'MacOS' and !$([MSBuild]::IsOSPlatform('OSX'))))" Text="A foreign-OS audio build requires an explicit target toolchain or prebuilt library." />
  </Target>
  <Target Name="BuildElectron2DAudioNative" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems;ComputeFilesToPublish" DependsOnTargets="ValidateElectron2DAudioNative" Condition="'$(Electron2DAudioNativeEnabled)' == 'true' and '$(Electron2DAudioNativeLibrary)' == ''" Inputs="@(_Electron2DAudioInput);$(Electron2DAudioNativeToolchain)" Outputs="$(_Electron2DAudioLibrary)">
    <Exec Command="cmake -S &quot;$(_Electron2DAudioWrapper)&quot; -B &quot;$(_Electron2DAudioBuild)-output&quot; -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_SDL3=ON -DELECTRON2D_SDL_VERSION=$(Electron2DSDLVersion) -DSDL3_LIBRARIES=&quot;$(_Electron2DAudioSDL)&quot; -DXNASONG=OFF -DBUILD_TESTS=OFF -DBUILD_UTILS=OFF $(_Electron2DAudioToolchainArg)" />
    <Exec Command="cmake --build &quot;$(_Electron2DAudioBuild)-output&quot; --target FAudio-shared --config Release --parallel $(Electron2DAudioNativeJobs)" />
    <Copy SourceFiles="$(_Electron2DAudioBuild)-output/$(_Electron2DAudioName)" DestinationFiles="$(_Electron2DAudioLibrary)" />
  </Target>
</Project>
