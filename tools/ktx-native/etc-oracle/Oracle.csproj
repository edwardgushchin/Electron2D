<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireOracleSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EtcOracleSource)' == ''" Text="Set EtcOracleSource to the pinned AssetRipper.TextureDecoder project directory." />
  </Target>
  <ItemGroup Condition="'$(EtcOracleSource)' != ''">
    <Compile Include="$(EtcOracleSource)/**/*.cs" Exclude="$(EtcOracleSource)/obj/**;$(EtcOracleSource)/bin/**" />
  </ItemGroup>
</Project>
