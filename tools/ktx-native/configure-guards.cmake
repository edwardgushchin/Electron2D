set(before [=[if (CPU_ARCHITECTURE STREQUAL x86)
    message(FATAL_ERROR "This project cannot be built for x86 cpu.")
endif()]=])
set(after "# Electron2D builds the bounded scalar codec on its 32-bit targets.")
foreach(name CMakeLists.txt lib/CMakeLists.txt)
  set(source "${ROOT}/${name}")
  file(READ "${source}" text)
  string(FIND "${text}" "${after}" patched)
  if(patched LESS 0)
    string(FIND "${text}" "${before}" original)
    if(original LESS 0)
      message(FATAL_ERROR "Pinned KTX architecture build guard no longer matches")
    endif()
    string(REPLACE "${before}" "${after}" text "${text}")
    file(WRITE "${source}" "${text}")
  endif()
endforeach()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${CMAKE_CURRENT_LIST_DIR}/prepare_memory.py" "${ROOT}"
  COMMAND_ERROR_IS_FATAL ANY)
