<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredCompilation>false</TieredCompilation>
    <DefineConstants>$(DefineConstants);CORECLR_SOURCE_PROBE</DefineConstants>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../aot-memory-probe/Program.cs;../aot-memory-probe/FrozenChecks.cs;../aot-memory-probe/NativeChecks.cs;../aot-memory-probe/CommonChecks.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
