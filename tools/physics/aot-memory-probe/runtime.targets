<Project>
  <ItemGroup>
    <DirectPInvoke Include="Electron2DAOTMemory" />
    <NativeLibrary Include="$(ProbeNativeObject)" />
    <NativeLibrary Include="$(ProbeFrozenObject)" />
    <NativeLibrary Include="$(ProbeMemoryLibrary)" />
    <None Include="$(ProbeMemoryLibrary)" Link="runtimes/linux-x64/native/libElectron2DENet.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ReplaceDiagnosticRuntime" AfterTargets="SetupOSSpecificProps">
    <ItemGroup Condition="'$(ProbeRuntimeArchive)' != ''">
      <NativeLibrary Remove="$(IlcSdkPath)$(FullRuntimeName).a" />
      <NativeLibrary Include="$(ProbeRuntimeArchive)" />
      <_ProbeLinkerArg Include="@(LinkerArg)">
        <Path Condition="'%(Identity)' == '$(IlcSdkPath)$(FullRuntimeName).a'">$(ProbeRuntimeArchive)</Path>
        <Path Condition="'%(Identity)' != '$(IlcSdkPath)$(FullRuntimeName).a'">%(Identity)</Path>
      </_ProbeLinkerArg>
      <LinkerArg Remove="@(LinkerArg)" />
      <LinkerArg Include="@(_ProbeLinkerArg->'%(Path)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(NativeIntermediateOutputPath)e2d-runtime-inputs.txt" Lines="@(LinkerArg)" Overwrite="true" />
  </Target>
</Project>
