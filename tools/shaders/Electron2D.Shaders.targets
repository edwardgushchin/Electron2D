<Project>
  <PropertyGroup>
    <Electron2DShaderImportTool Condition="'$(Electron2DShaderImportTool)' == ''">$(MSBuildThisFileDirectory)Electron2D.ShaderImport</Electron2DShaderImportTool>
    <Electron2DShaderImportTimeoutMS Condition="'$(Electron2DShaderImportTimeoutMS)' == ''">300000</Electron2DShaderImportTimeoutMS>
  </PropertyGroup>
  <UsingTask TaskName="Electron2DImportShaders" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ProjectDirectory ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <ToolPath ParameterType="System.String" Required="true" />
      <Compile ParameterType="System.Boolean" />
      <TimeoutMS ParameterType="System.Int32" Required="true" />
      <Outputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        try
        {
            var directory = Path.GetFullPath(Path.Combine(ProjectDirectory, OutputDirectory));
            var outputs = new List<Microsoft.Build.Framework.ITaskItem>();
            var paths = new HashSet<string>(Path.DirectorySeparatorChar == '\\'
                ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal);
            foreach (var source in Sources)
            {
                var input = source.GetMetadata("FullPath");
                var stage = source.GetMetadata("Stage");
                var profile = source.GetMetadata("Profile");
                if (profile.Length != 0 && profile != "canvas" && profile != "device" && profile != "texture-blit" && profile != "particles" && profile != "visual-shader")
                    throw new ArgumentException(input + ": Profile must be canvas, device, texture-blit, particles or visual-shader.");
                var device = profile == "device" || profile == "particles";
                var graph = profile == "visual-shader";
                if (graph && stage != "canvas") throw new ArgumentException(input + ": Visual shaders require the canvas domain.");
                if (profile == "particles" && stage != "compute") throw new ArgumentException(input + ": Particle programs require a compute stage.");
                if (profile == "texture-blit" && stage != "fragment") throw new ArgumentException(input + ": Blit programs require a fragment stage.");
                if (!graph && stage != "vertex" && stage != "fragment" && !(device && stage == "compute"))
                    throw new ArgumentException(input + ": Stage must be vertex/fragment, or compute for Profile=device/particles.");
                var target = source.GetMetadata("TargetPath");
                if (target.Length == 0)
                {
                    target = source.GetMetadata("Link");
                    if (target.Length == 0) target = source.ItemSpec;
                    target += graph ? ".compiled.e2dres" : ".spv";
                }
                target = target.Replace('\\', '/');
                if (Path.IsPathRooted(target) || target.Contains(':') ||
                    Array.Exists(target.Split('/'), part => part == ".." || part == "." || part.Length == 0) ||
                    !target.EndsWith(graph ? ".e2dres" : ".spv", StringComparison.OrdinalIgnoreCase))
                    throw new ArgumentException(input + ": TargetPath must be a relative " + (graph ? ".e2dres" : ".spv") + " path without . or .. components.");
                var output = Path.Combine(directory, target);
                if (!paths.Add(output)) throw new ArgumentException("Duplicate shader TargetPath: " + target);
                var item = new Microsoft.Build.Utilities.TaskItem(output);
                item.SetMetadata("TargetPath", target);
                item.SetMetadata("CopyToOutputDirectory", "PreserveNewest");
                item.SetMetadata("CopyToPublishDirectory", "PreserveNewest");
                item.SetMetadata("Source", input);
                item.SetMetadata("Stage", stage);
                item.SetMetadata("Profile", profile.Length == 0 ? "canvas" : profile);
                outputs.Add(item);
            }
            if (Compile)
            {
                if (TimeoutMS <= 0) throw new ArgumentOutOfRangeException("TimeoutMS", "Shader import requires a positive deadline.");
                var tool = Path.GetFullPath(Path.Combine(ProjectDirectory, ToolPath));
                if (!File.Exists(tool)) throw new FileNotFoundException("Electron2DShaderImportTool is missing: " + tool);
                // ponytail: compile on every build so native include resolution stays authoritative;
                // skip compilation only after a complete dependency cache is implemented and measured.
                foreach (var output in outputs)
                {
                    Directory.CreateDirectory(Path.GetDirectoryName(output.ItemSpec));
                    var stagingPath = Path.Combine(Path.GetDirectoryName(output.ItemSpec), "." + Path.GetFileNameWithoutExtension(output.ItemSpec) +
                        ".import-" + Guid.NewGuid().ToString("N") + Path.GetExtension(output.ItemSpec));
                    try
                    {
                        var start = new ProcessStartInfo(tool) {
                            UseShellExecute = false, RedirectStandardOutput = true, RedirectStandardError = true,
                            WorkingDirectory = ProjectDirectory
                        };
                        if (output.GetMetadata("Profile") == "visual-shader")
                            start.EnvironmentVariables["ELECTRON2D_SHADER_IMPORT_OUTPUT_IDENTITY"] = output.ItemSpec;
                        // The task factory compiles against netstandard2.0; dotnet MSBuild
                        // provides ArgumentList at runtime, avoiding shell/string argument parsing.
                        var property = typeof(ProcessStartInfo).GetProperty("ArgumentList");
                        if (property == null) throw new NotSupportedException("Shader import requires dotnet MSBuild.");
                        var arguments = (IList<string>)property.GetValue(start);
                        arguments.Add(output.GetMetadata("Source"));
                        arguments.Add(output.GetMetadata("Stage"));
                        arguments.Add(stagingPath);
                        if (output.GetMetadata("Profile") == "device") arguments.Add("--device");
                        if (output.GetMetadata("Profile") == "texture-blit") arguments.Add("--texture-blit");
                        if (output.GetMetadata("Profile") == "particles") arguments.Add("--particles");
                        if (output.GetMetadata("Profile") == "visual-shader") arguments.Add("--visual-shader");
                        using (var process = Process.Start(start))
                        {
                            if (process == null) throw new InvalidOperationException("Cannot start " + tool);
                            var stdout = process.StandardOutput.ReadToEndAsync();
                            var stderr = process.StandardError.ReadToEndAsync();
                            var watch = Stopwatch.StartNew();
                            var exited = process.WaitForExit(TimeoutMS);
                            var remaining = Math.Max(1, TimeoutMS - (int)Math.Min(int.MaxValue, watch.ElapsedMilliseconds));
                            var drained = exited && System.Threading.Tasks.Task.WaitAll(new System.Threading.Tasks.Task[] { stdout, stderr }, remaining);
                            if (!drained)
                            {
                                if (!process.HasExited)
                                {
                                    var killTree = typeof(Process).GetMethod("Kill", new[] { typeof(bool) });
                                    if (killTree == null) throw new NotSupportedException("Bounded shader import requires modern dotnet MSBuild.");
                                    killTree.Invoke(process, new object[] { true });
                                    process.WaitForExit(5000);
                                }
                                throw new TimeoutException("Shader import exceeded " + TimeoutMS + " ms: " + output.GetMetadata("Source"));
                            }
                            var diagnostic = stdout.GetAwaiter().GetResult() + stderr.GetAwaiter().GetResult();
                            if (process.ExitCode != 0)
                            {
                                Log.LogError("Shader import failed ({0}): {1}", process.ExitCode, diagnostic);
                                return false;
                            }
                            if (!File.Exists(stagingPath)) throw new InvalidDataException("Shader importer produced no artifact: " + output.GetMetadata("Source"));
                            if ((File.GetAttributes(stagingPath) & FileAttributes.ReparsePoint) != 0) throw new InvalidDataException("Shader importer output must be a regular file.");
                            var same = File.Exists(output.ItemSpec) && new FileInfo(output.ItemSpec).Length == new FileInfo(stagingPath).Length &&
                                File.ReadAllBytes(output.ItemSpec).SequenceEqual(File.ReadAllBytes(stagingPath));
                            if (!same)
                            {
                                if (File.Exists(output.ItemSpec)) File.Replace(stagingPath, output.ItemSpec, null);
                                else File.Move(stagingPath, output.ItemSpec);
                            }
                            Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal, "{0}", diagnostic.Replace(stagingPath, output.ItemSpec));
                        }
                    }
                    finally { File.Delete(stagingPath); }
                }
            }
            Outputs = outputs.ToArray();
        }
        catch (Exception error)
        {
            Log.LogError("{0}", error.Message);
            return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="_PrepareElectron2DShaders" BeforeTargets="AssignTargetPaths"
          Condition="'@(Electron2DShader)' != '' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Electron2DImportShaders Sources="@(Electron2DShader)" ProjectDirectory="$(MSBuildProjectDirectory)"
                            OutputDirectory="$(IntermediateOutputPath)Electron2D/shaders" ToolPath="$(Electron2DShaderImportTool)" TimeoutMS="$(Electron2DShaderImportTimeoutMS)">
      <Output TaskParameter="Outputs" ItemName="_Electron2DShaderOutput" />
    </Electron2DImportShaders>
    <ItemGroup>
      <Content Include="@(_Electron2DShaderOutput)" />
      <FileWrites Include="@(_Electron2DShaderOutput)" />
    </ItemGroup>
  </Target>
  <Target Name="_CompileElectron2DShaders" BeforeTargets="CoreCompile" DependsOnTargets="_PrepareElectron2DShaders"
          Condition="'@(Electron2DShader)' != '' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Electron2DImportShaders Sources="@(Electron2DShader)" ProjectDirectory="$(MSBuildProjectDirectory)" Compile="true"
                            OutputDirectory="$(IntermediateOutputPath)Electron2D/shaders" ToolPath="$(Electron2DShaderImportTool)" TimeoutMS="$(Electron2DShaderImportTimeoutMS)" />
  </Target>
</Project>
