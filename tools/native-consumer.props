<Project>
  <Import Project="native-package.props" />
  <PropertyGroup>
    <Version>$(Electron2DVersion)</Version>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(TargetFramework)' == 'net10.0'">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">MacOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">Windows</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">Linux</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">MacOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(TargetFramework)').EndsWith('-android'))">Android</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(TargetFramework)').EndsWith('-ios'))">iOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(TargetFramework)').EndsWith('-tvos'))">tvOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">Web</Electron2DConsumerPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Electron2D.$(Electron2DConsumerPlatform)" Version="[$(Electron2DNativePackageVersion)]" />
    <PackageReference Include="SDL3-CS.Android" Version="$(Electron2DSDLVersion)" ExcludeAssets="compile;runtime;native" Condition="'$(Electron2DConsumerPlatform)' == 'Android' and '$(Electron2DUsePackage)' != 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Electron2DUsePackage)' == 'true'">
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../Electron2D.csproj" />
    <PackageReference Include="Electron2D" Version="[$(Electron2DVersion)]" />
  </ItemGroup>
  <PropertyGroup>
    <_Electron2DConsumerCryptoName>libcrypto.so.4</_Electron2DConsumerCryptoName>
    <_Electron2DConsumerSSLName>libssl.so.4</_Electron2DConsumerSSLName>
    <_Electron2DConsumerCryptoName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DCrypto.4.dylib</_Electron2DConsumerCryptoName>
    <_Electron2DConsumerSSLName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DSSL.4.dylib</_Electron2DConsumerSSLName>
    <_Electron2DConsumerCryptoName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">libcrypto-4-Electron2D.dll</_Electron2DConsumerCryptoName>
    <_Electron2DConsumerSSLName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">libssl-4-Electron2D.dll</_Electron2DConsumerSSLName>
    <_Electron2DConsumerCryptoPath Condition="'$(Electron2DTLSNativeDirectory)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DTLSNativeDirectory)/$(_Electron2DConsumerCryptoName)'))</_Electron2DConsumerCryptoPath>
    <_Electron2DConsumerSSLPath Condition="'$(Electron2DTLSNativeDirectory)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DTLSNativeDirectory)/$(_Electron2DConsumerSSLName)'))</_Electron2DConsumerSSLPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerTLSOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DTLSNativeDirectory)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerCryptoName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerCryptoName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerCryptoPath)'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerSSLName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerSSLName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerSSLPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerTLSOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DTLSNativeDirectory)' != ''">
    <ItemGroup>
      <_Electron2DConsumerTLS Include="$(Electron2DTLSNativeDirectory)/$(_Electron2DConsumerCryptoName);$(Electron2DTLSNativeDirectory)/$(_Electron2DConsumerSSLName)" />
    </ItemGroup>
    <Copy SourceFiles="@(_Electron2DConsumerTLS)" DestinationFolder="$(TargetDir)runtimes/$(RuntimeIdentifier)/native">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <Copy SourceFiles="@(_Electron2DConsumerTLS)" DestinationFolder="$(PublishDir)runtimes/$(RuntimeIdentifier)/native" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <PropertyGroup>
    <_Electron2DConsumerNativePath Condition="'$(Electron2DNativeLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DNativeLibrary)'))</_Electron2DConsumerNativePath>
    <_Electron2DConsumerNativeName>libElectron2D.so</_Electron2DConsumerNativeName>
    <_Electron2DConsumerNativeName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2D.dylib</_Electron2DConsumerNativeName>
    <_Electron2DConsumerNativeName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">libElectron2D.dll</_Electron2DConsumerNativeName>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerNativeOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerNativeName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerNativeName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerNativePath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerNativeOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <Copy SourceFiles="$(Electron2DNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerNativeName)">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <Copy SourceFiles="$(Electron2DNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerNativeName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <Target Name="CopyElectron2DConsumerAudioOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DAudioNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <PropertyGroup>
      <_Electron2DConsumerAudioName>libFAudio.so.0</_Electron2DConsumerAudioName>
      <_Electron2DConsumerAudioName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libFAudio.0.dylib</_Electron2DConsumerAudioName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DAudioNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerAudioName)">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <Copy SourceFiles="$(Electron2DAudioNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerAudioName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <PropertyGroup>
    <_Electron2DConsumerSDLName>libSDL3.so.0</_Electron2DConsumerSDLName>
    <_Electron2DConsumerSDLName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libSDL3.0.dylib</_Electron2DConsumerSDLName>
    <_Electron2DConsumerSDLPath Condition="'$(Electron2DSDLNativeLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DSDLNativeLibrary)'))</_Electron2DConsumerSDLPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerSDLOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DSDLNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerSDLName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerSDLName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerSDLPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerSDLOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DSDLNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <Copy SourceFiles="$(Electron2DSDLNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerSDLName)">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <Copy SourceFiles="$(Electron2DSDLNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerSDLName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <PropertyGroup>
    <_Electron2DConsumerHarfBuzzName>libHarfBuzzSharp.so</_Electron2DConsumerHarfBuzzName>
    <_Electron2DConsumerHarfBuzzName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libHarfBuzzSharp.dylib</_Electron2DConsumerHarfBuzzName>
    <_Electron2DConsumerHarfBuzzName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">libHarfBuzzSharp.dll</_Electron2DConsumerHarfBuzzName>
    <_Electron2DConsumerHarfBuzzPath Condition="'$(Electron2DHarfBuzzNativeLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DHarfBuzzNativeLibrary)'))</_Electron2DConsumerHarfBuzzPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerHarfBuzzOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DHarfBuzzNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerHarfBuzzName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerHarfBuzzName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerHarfBuzzPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerHarfBuzzOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DHarfBuzzNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <Copy SourceFiles="$(Electron2DHarfBuzzNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerHarfBuzzName)">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <Copy SourceFiles="$(Electron2DHarfBuzzNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerHarfBuzzName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
</Project>
