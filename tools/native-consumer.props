<Project>
  <Import Project="native-package.props" />
  <PropertyGroup>
    <Version>$(Electron2DVersion)</Version>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(TargetFramework)' == 'net10.0'">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">MacOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">Windows</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">Linux</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">MacOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(TargetFramework)').EndsWith('-android'))">Android</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(TargetFramework)').EndsWith('-ios'))">iOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(TargetFramework)').EndsWith('-tvos'))">tvOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">Web</Electron2DConsumerPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Electron2D.$(Electron2DConsumerPlatform)" Version="[$(Electron2DNativePackageVersion)]" />
    <PackageReference Include="SDL3-CS.Android" Version="$(Electron2DSDLVersion)" ExcludeAssets="compile;runtime;native" Condition="'$(Electron2DConsumerPlatform)' == 'Android' and '$(Electron2DUsePackage)' != 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Electron2DUsePackage)' == 'true'">
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../Electron2D.csproj" />
    <PackageReference Include="Electron2D" Version="[$(Electron2DVersion)]" />
  </ItemGroup>
  <Target Name="CopyElectron2DConsumerRenderOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DRenderNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <PropertyGroup>
      <_Electron2DConsumerRenderName>libElectron2DRender.so</_Electron2DConsumerRenderName>
      <_Electron2DConsumerRenderName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DRender.dylib</_Electron2DConsumerRenderName>
      <_Electron2DConsumerRenderName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">Electron2DRender.dll</_Electron2DConsumerRenderName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DRenderNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerRenderName)" />
    <Copy SourceFiles="$(Electron2DRenderNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerRenderName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <Target Name="CopyElectron2DConsumerAudioOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DAudioNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <PropertyGroup>
      <_Electron2DConsumerAudioName>libFAudio.so.0</_Electron2DConsumerAudioName>
      <_Electron2DConsumerAudioName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libFAudio.0.dylib</_Electron2DConsumerAudioName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DAudioNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerAudioName)" />
    <Copy SourceFiles="$(Electron2DAudioNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerAudioName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <Target Name="CopyElectron2DConsumerENetOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DENetNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <PropertyGroup>
      <_Electron2DConsumerENetName>libElectron2DENet.so</_Electron2DConsumerENetName>
      <_Electron2DConsumerENetName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DENet.dylib</_Electron2DConsumerENetName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DENetNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerENetName)" />
    <Copy SourceFiles="$(Electron2DENetNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerENetName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <Target Name="CopyElectron2DConsumerTextOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DTextNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <PropertyGroup>
      <_Electron2DConsumerTextName>libElectron2DTextBreak.so</_Electron2DConsumerTextName>
      <_Electron2DConsumerTextName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DTextBreak.dylib</_Electron2DConsumerTextName>
      <_Electron2DConsumerTextName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">Electron2DTextBreak.dll</_Electron2DConsumerTextName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DTextNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerTextName)" />
    <Copy SourceFiles="$(Electron2DTextNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerTextName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <Target Name="CopyElectron2DConsumerKTXOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DKTXNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <PropertyGroup>
      <_Electron2DConsumerKTXName>libElectron2DKTX.so</_Electron2DConsumerKTXName>
      <_Electron2DConsumerKTXName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DKTX.dylib</_Electron2DConsumerKTXName>
      <_Electron2DConsumerKTXName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">Electron2DKTX.dll</_Electron2DConsumerKTXName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DKTXNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerKTXName)" />
    <Copy SourceFiles="$(Electron2DKTXNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerKTXName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <PropertyGroup>
    <_Electron2DConsumerWebPName>libElectron2DWebP.so</_Electron2DConsumerWebPName>
    <_Electron2DConsumerWebPName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DWebP.dylib</_Electron2DConsumerWebPName>
    <_Electron2DConsumerWebPPath Condition="'$(Electron2DWebPNativeLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DWebPNativeLibrary)'))</_Electron2DConsumerWebPPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerWebPOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DWebPNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerWebPName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerWebPName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerWebPPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerWebPOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DWebPNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <Copy SourceFiles="$(Electron2DWebPNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerWebPName)" />
    <Copy SourceFiles="$(Electron2DWebPNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerWebPName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
</Project>
