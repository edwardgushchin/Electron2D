<Project>
  <Import Project="native-package.props" />
  <PropertyGroup>
    <Version>$(Electron2DVersion)</Version>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(TargetFramework)' == 'net10.0'">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">MacOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">Windows</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">Linux</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">MacOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(TargetFramework)').EndsWith('-android'))">Android</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(TargetFramework)').EndsWith('-ios'))">iOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="$([System.String]::Copy('$(TargetFramework)').EndsWith('-tvos'))">tvOS</Electron2DConsumerPlatform>
    <Electron2DConsumerPlatform Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">Web</Electron2DConsumerPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Electron2D.$(Electron2DConsumerPlatform)" Version="[$(Electron2DNativePackageVersion)]" />
    <PackageReference Include="SDL3-CS.Android" Version="$(Electron2DSDLVersion)" ExcludeAssets="compile;runtime;native" Condition="'$(Electron2DConsumerPlatform)' == 'Android' and '$(Electron2DUsePackage)' != 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Electron2DUsePackage)' == 'true'">
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../Electron2D.csproj" />
    <PackageReference Include="Electron2D" Version="[$(Electron2DVersion)]" />
  </ItemGroup>
  <PropertyGroup>
    <_Electron2DConsumerCryptoName>libcrypto.so.4</_Electron2DConsumerCryptoName>
    <_Electron2DConsumerSSLName>libssl.so.4</_Electron2DConsumerSSLName>
    <_Electron2DConsumerCryptoName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DCrypto.4.dylib</_Electron2DConsumerCryptoName>
    <_Electron2DConsumerSSLName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DSSL.4.dylib</_Electron2DConsumerSSLName>
    <_Electron2DConsumerCryptoName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">libcrypto-4-Electron2D.dll</_Electron2DConsumerCryptoName>
    <_Electron2DConsumerSSLName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">libssl-4-Electron2D.dll</_Electron2DConsumerSSLName>
    <_Electron2DConsumerCryptoPath Condition="'$(Electron2DTLSNativeDirectory)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DTLSNativeDirectory)/$(_Electron2DConsumerCryptoName)'))</_Electron2DConsumerCryptoPath>
    <_Electron2DConsumerSSLPath Condition="'$(Electron2DTLSNativeDirectory)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DTLSNativeDirectory)/$(_Electron2DConsumerSSLName)'))</_Electron2DConsumerSSLPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerTLSOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DTLSNativeDirectory)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerCryptoName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerCryptoName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerCryptoPath)'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerSSLName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerSSLName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerSSLPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerTLSOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DTLSNativeDirectory)' != ''">
    <ItemGroup>
      <_Electron2DConsumerTLS Include="$(Electron2DTLSNativeDirectory)/$(_Electron2DConsumerCryptoName);$(Electron2DTLSNativeDirectory)/$(_Electron2DConsumerSSLName)" />
    </ItemGroup>
    <Copy SourceFiles="@(_Electron2DConsumerTLS)" DestinationFolder="$(TargetDir)runtimes/$(RuntimeIdentifier)/native" />
    <Copy SourceFiles="@(_Electron2DConsumerTLS)" DestinationFolder="$(PublishDir)runtimes/$(RuntimeIdentifier)/native" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <Target Name="CopyElectron2DConsumerRenderOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DRenderNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <PropertyGroup>
      <_Electron2DConsumerRenderName>libElectron2DRender.so</_Electron2DConsumerRenderName>
      <_Electron2DConsumerRenderName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DRender.dylib</_Electron2DConsumerRenderName>
      <_Electron2DConsumerRenderName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">Electron2DRender.dll</_Electron2DConsumerRenderName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DRenderNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerRenderName)" />
    <Copy SourceFiles="$(Electron2DRenderNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerRenderName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <Target Name="CopyElectron2DConsumerAudioOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DAudioNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <PropertyGroup>
      <_Electron2DConsumerAudioName>libFAudio.so.0</_Electron2DConsumerAudioName>
      <_Electron2DConsumerAudioName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libFAudio.0.dylib</_Electron2DConsumerAudioName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DAudioNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerAudioName)" />
    <Copy SourceFiles="$(Electron2DAudioNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerAudioName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <Target Name="CopyElectron2DConsumerENetOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DENetNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <PropertyGroup>
      <_Electron2DConsumerENetName>libElectron2DENet.so</_Electron2DConsumerENetName>
      <_Electron2DConsumerENetName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DENet.dylib</_Electron2DConsumerENetName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DENetNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerENetName)" />
    <Copy SourceFiles="$(Electron2DENetNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerENetName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <Target Name="CopyElectron2DConsumerTextOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DTextNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <PropertyGroup>
      <_Electron2DConsumerTextName>libElectron2DTextBreak.so</_Electron2DConsumerTextName>
      <_Electron2DConsumerTextName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DTextBreak.dylib</_Electron2DConsumerTextName>
      <_Electron2DConsumerTextName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">Electron2DTextBreak.dll</_Electron2DConsumerTextName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DTextNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerTextName)" />
    <Copy SourceFiles="$(Electron2DTextNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerTextName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <Target Name="CopyElectron2DConsumerKTXOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DKTXNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <PropertyGroup>
      <_Electron2DConsumerKTXName>libElectron2DKTX.so</_Electron2DConsumerKTXName>
      <_Electron2DConsumerKTXName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DKTX.dylib</_Electron2DConsumerKTXName>
      <_Electron2DConsumerKTXName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">Electron2DKTX.dll</_Electron2DConsumerKTXName>
    </PropertyGroup>
    <Copy SourceFiles="$(Electron2DKTXNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerKTXName)" />
    <Copy SourceFiles="$(Electron2DKTXNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerKTXName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <PropertyGroup>
    <_Electron2DConsumerWebPName>libElectron2DWebP.so</_Electron2DConsumerWebPName>
    <_Electron2DConsumerWebPName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DWebP.dylib</_Electron2DConsumerWebPName>
    <_Electron2DConsumerWebPPath Condition="'$(Electron2DWebPNativeLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DWebPNativeLibrary)'))</_Electron2DConsumerWebPPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerWebPOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DWebPNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerWebPName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerWebPName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerWebPPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerWebPOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DWebPNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <Copy SourceFiles="$(Electron2DWebPNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerWebPName)" />
    <Copy SourceFiles="$(Electron2DWebPNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerWebPName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <PropertyGroup>
    <_Electron2DConsumerMeshName>libElectron2DMesh.so</_Electron2DConsumerMeshName>
    <_Electron2DConsumerMeshName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DMesh.dylib</_Electron2DConsumerMeshName>
    <_Electron2DConsumerMeshPath Condition="'$(Electron2DMeshNativeLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DMeshNativeLibrary)'))</_Electron2DConsumerMeshPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerMeshOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DMeshNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerMeshName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerMeshName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerMeshPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerMeshOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DMeshNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <Copy SourceFiles="$(Electron2DMeshNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerMeshName)" />
    <Copy SourceFiles="$(Electron2DMeshNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerMeshName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <PropertyGroup>
    <_Electron2DConsumerSDLName>libSDL3.so.0</_Electron2DConsumerSDLName>
    <_Electron2DConsumerSDLName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libSDL3.0.dylib</_Electron2DConsumerSDLName>
    <_Electron2DConsumerSDLPath Condition="'$(Electron2DSDLNativeLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DSDLNativeLibrary)'))</_Electron2DConsumerSDLPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerSDLOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DSDLNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerSDLName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerSDLName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerSDLPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerSDLOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DSDLNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <Copy SourceFiles="$(Electron2DSDLNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerSDLName)" />
    <Copy SourceFiles="$(Electron2DSDLNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerSDLName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <PropertyGroup>
    <_Electron2DConsumerHarfBuzzName>libHarfBuzzSharp.so</_Electron2DConsumerHarfBuzzName>
    <_Electron2DConsumerHarfBuzzName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libHarfBuzzSharp.dylib</_Electron2DConsumerHarfBuzzName>
    <_Electron2DConsumerHarfBuzzName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">libHarfBuzzSharp.dll</_Electron2DConsumerHarfBuzzName>
    <_Electron2DConsumerHarfBuzzPath Condition="'$(Electron2DHarfBuzzNativeLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DHarfBuzzNativeLibrary)'))</_Electron2DConsumerHarfBuzzPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerHarfBuzzOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DHarfBuzzNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerHarfBuzzName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerHarfBuzzName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerHarfBuzzPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerHarfBuzzOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DHarfBuzzNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <Copy SourceFiles="$(Electron2DHarfBuzzNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerHarfBuzzName)" />
    <Copy SourceFiles="$(Electron2DHarfBuzzNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerHarfBuzzName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <PropertyGroup>
    <_Electron2DConsumerOGVName>libElectron2DOGV.so</_Electron2DConsumerOGVName>
    <_Electron2DConsumerOGVName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DOGV.dylib</_Electron2DConsumerOGVName>
    <_Electron2DConsumerOGVPath Condition="'$(Electron2DOGVNativeLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DOGVNativeLibrary)'))</_Electron2DConsumerOGVPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerOGVOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DOGVNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerOGVName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerOGVName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerOGVPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerOGVOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DOGVNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS')">
    <Copy SourceFiles="$(Electron2DOGVNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerOGVName)" />
    <Copy SourceFiles="$(Electron2DOGVNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerOGVName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
  <PropertyGroup>
    <_Electron2DConsumerWebRTCName>libElectron2DWebRTC.so</_Electron2DConsumerWebRTCName>
    <_Electron2DConsumerWebRTCName Condition="'$(Electron2DConsumerPlatform)' == 'MacOS'">libElectron2DWebRTC.dylib</_Electron2DConsumerWebRTCName>
    <_Electron2DConsumerWebRTCName Condition="'$(Electron2DConsumerPlatform)' == 'Windows'">Electron2DWebRTC.dll</_Electron2DConsumerWebRTCName>
    <_Electron2DConsumerWebRTCPath Condition="'$(Electron2DWebRTCNativeLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(Electron2DWebRTCNativeLibrary)'))</_Electron2DConsumerWebRTCPath>
  </PropertyGroup>
  <Target Name="SelectElectron2DConsumerWebRTCOverride" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(Electron2DWebRTCNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(ResolvedFileToPublish.RelativePath)' == 'runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerWebRTCName)' or '%(ResolvedFileToPublish.RelativePath)' == 'runtimes\$(RuntimeIdentifier)\native\$(_Electron2DConsumerWebRTCName)') and '%(ResolvedFileToPublish.FullPath)' != '$(_Electron2DConsumerWebRTCPath)'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyElectron2DConsumerWebRTCOverride" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Electron2DWebRTCNativeLibrary)' != '' and ('$(Electron2DConsumerPlatform)' == 'Linux' or '$(Electron2DConsumerPlatform)' == 'MacOS' or '$(Electron2DConsumerPlatform)' == 'Windows')">
    <Copy SourceFiles="$(Electron2DWebRTCNativeLibrary)" DestinationFiles="$(TargetDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerWebRTCName)" />
    <Copy SourceFiles="$(Electron2DWebRTCNativeLibrary)" DestinationFiles="$(PublishDir)runtimes/$(RuntimeIdentifier)/native/$(_Electron2DConsumerWebRTCName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
</Project>
