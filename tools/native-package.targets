<Project>
  <PropertyGroup>
    <NativeArtifacts Condition="'$(NativeArtifacts)' == ''">$(MSBuildThisFileDirectory)../bin/native-artifacts</NativeArtifacts>
  </PropertyGroup>
  <Target Name="BuildElectron2DNativeAssets" DependsOnTargets="BuildElectron2DNative;BuildElectron2DAudioNative;BuildElectron2DFontNative;BuildElectron2DShapingNative;BuildElectron2DTLSNative">
    <Error Condition="'$(Electron2DBuildNativeFromSource)' != 'true'" Text="Native compilation requires -p:Electron2DBuildNativeFromSource=true." />
    <Copy SourceFiles="$(_Electron2DNativeLibrary);$(_Electron2DAudioLibrary);$(_Electron2DFontLibrary);$(_Electron2DShapingLibrary);@(_Electron2DTLSNative)" DestinationFolder="$(NativeArtifacts)/runtimes/$(_Electron2DPrivateNativeRID)/native" />
    <Exec Command="$(Electron2DNativePython) -B &quot;$(MSBuildThisFileDirectory)native/package.py&quot; stage $(_Electron2DPrivateNativeRID) &quot;$(NativeArtifacts)&quot;" />
    <Exec Condition="'$(Electron2DNativePlatform)' == 'Linux'" Command="$(Electron2DNativePython) -B &quot;$(MSBuildThisFileDirectory)native/check_dispatch.py&quot; &quot;$(NativeArtifacts)/runtimes/$(_Electron2DPrivateNativeRID)/native/$(_Electron2DNativeName)&quot; &quot;$(_Electron2DNativeSDL)&quot;" />
  </Target>
</Project>
