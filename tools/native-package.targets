<Project>
  <PropertyGroup>
    <NativeArtifacts Condition="'$(NativeArtifacts)' == ''">$(MSBuildThisFileDirectory)../bin/native-artifacts</NativeArtifacts>
  </PropertyGroup>
  <ItemGroup Condition="'$(Electron2DNativePlatform)' == 'Windows' and '$(Electron2DBuildNativeFromSource)' != 'true'">
    <None Include="$(PkgElectron2D_Windows)/runtimes/$(_Electron2DPrivateNativeRID)/native/*.dll" Link="runtimes/$(_Electron2DPrivateNativeRID)/native/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" Visible="false" />
  </ItemGroup>
  <Target Name="BuildElectron2DNativeAssets">
    <Error Condition="'$(Electron2DBuildNativeFromSource)' != 'true'" Text="Native compilation requires -p:Electron2DBuildNativeFromSource=true." />
    <Error Condition="'$(Electron2DNativePlatform)' != 'Linux' and '$(Electron2DNativePlatform)' != 'MacOS'" Text="Private native builds require a supported Linux or MacOS profile." />
    <CallTarget Targets="BuildElectron2DTextNative;BuildElectron2DAudioNative;BuildElectron2DENetNative;BuildElectron2DTLSNative;BuildElectron2DWebRTCNative;BuildElectron2DMeshNative;BuildElectron2DRenderNative;BuildElectron2DWebPNative;BuildElectron2DKTXNative;BuildElectron2DOGVNative;CheckElectron2DOGVNative;BuildElectron2DTLSNative;BuildElectron2DFontNative" />
    <Copy SourceFiles="$(_Electron2DTextNativeLibrary);$(_Electron2DAudioLibrary);$(_Electron2DENetLibrary);$(_Electron2DWebRTCLibrary);$(_Electron2DMeshLibrary);$(_Electron2DRenderLibrary);$(_Electron2DWebPLibrary);$(_Electron2DOGVLibrary);$(_Electron2DKTXLibrary);@(_Electron2DTLSNative)" DestinationFolder="$(NativeArtifacts)/runtimes/$(_Electron2DPrivateNativeRID)/native" />
    <CallTarget Targets="BuildElectron2DShapingNative" />
    <Copy SourceFiles="$(_Electron2DFontLibrary);$(_Electron2DShapingLibrary)" DestinationFolder="$(NativeArtifacts)/runtimes/$(_Electron2DPrivateNativeRID)/native" />
    <Exec Command="$(Electron2DNativePython) -B &quot;$(MSBuildThisFileDirectory)native/package.py&quot; stage $(_Electron2DPrivateNativeRID) &quot;$(NativeArtifacts)&quot;" />
  </Target>
</Project>
