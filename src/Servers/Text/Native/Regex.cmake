get_filename_component(PCRE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../Vendor/PCRE2" ABSOLUTE)
file(READ "${PCRE_ROOT}/manifest.json" PCRE_MANIFEST)
string(JSON PCRE_COUNT LENGTH "${PCRE_MANIFEST}" runtimeSources)
math(EXPR PCRE_LAST "${PCRE_COUNT} - 1")
set(PCRE_SOURCES)
foreach(index RANGE 0 ${PCRE_LAST})
    string(JSON name GET "${PCRE_MANIFEST}" runtimeSources ${index})
    list(APPEND PCRE_SOURCES "${PCRE_ROOT}/${name}")
endforeach()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/pcre2")
configure_file("${PCRE_ROOT}/src/config.h.generic" "${CMAKE_CURRENT_BINARY_DIR}/pcre2/config.h" COPYONLY)
configure_file("${PCRE_ROOT}/src/pcre2.h.generic" "${CMAKE_CURRENT_BINARY_DIR}/pcre2/pcre2.h" COPYONLY)
configure_file("${PCRE_ROOT}/src/pcre2_chartables.c.dist" "${CMAKE_CURRENT_BINARY_DIR}/pcre2/pcre2_chartables.c" COPYONLY)
add_library(Electron2DPCRE OBJECT ${PCRE_SOURCES} "${CMAKE_CURRENT_BINARY_DIR}/pcre2/pcre2_chartables.c")
target_include_directories(Electron2DPCRE PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/pcre2" "${PCRE_ROOT}/src")
target_compile_definitions(Electron2DPCRE PRIVATE HAVE_CONFIG_H PCRE2_STATIC PCRE2_CODE_UNIT_WIDTH=32 SUPPORT_PCRE2_32 SUPPORT_UNICODE)
set_target_properties(Electron2DPCRE PROPERTIES C_VISIBILITY_PRESET hidden POSITION_INDEPENDENT_CODE YES)
target_sources(Electron2DTextBreak PRIVATE Regex.cpp $<TARGET_OBJECTS:Electron2DPCRE>)
target_include_directories(Electron2DTextBreak PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/pcre2")
set_source_files_properties(Regex.cpp PROPERTIES COMPILE_DEFINITIONS "PCRE2_STATIC;PCRE2_CODE_UNIT_WIDTH=32")

if(MSVC)
    target_compile_options(Electron2DPCRE PRIVATE "/FI${CMAKE_CURRENT_LIST_DIR}/RegexSymbols.h" /O2 /utf-8)
    set_source_files_properties(Regex.cpp PROPERTIES COMPILE_OPTIONS "/FI${CMAKE_CURRENT_LIST_DIR}/RegexSymbols.h")
else()
    target_compile_options(Electron2DPCRE PRIVATE -include "${CMAKE_CURRENT_LIST_DIR}/RegexSymbols.h" -O2 -ffunction-sections -fdata-sections)
    set_source_files_properties(Regex.cpp PROPERTIES COMPILE_OPTIONS "-include;${CMAKE_CURRENT_LIST_DIR}/RegexSymbols.h")
endif()

add_executable(Electron2DRegexCheck EXCLUDE_FROM_ALL RegexCheck.cpp)
target_link_libraries(Electron2DRegexCheck PRIVATE Electron2DTextBreak)
add_executable(Electron2DRegexMemoryCheck EXCLUDE_FROM_ALL RegexMemoryCheck.cpp)
target_link_libraries(Electron2DRegexMemoryCheck PRIVATE Electron2DTextBreak)
target_include_directories(Electron2DRegexCheck PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/pcre2")
if(MSVC)
    target_compile_options(Electron2DRegexCheck PRIVATE /UNDEBUG /utf-8)
else()
    target_compile_options(Electron2DRegexCheck PRIVATE -UNDEBUG)
endif()
