#ifndef ELECTRON2D_COLOR_GLSL_INCLUDED
#define ELECTRON2D_COLOR_GLSL_INCLUDED
float Electron2D_SRGBToLinear(float value) {
    return value <= 0.04045 ? value / 12.92 : pow((value + 0.055) / 1.055, 2.4);
}
float Electron2D_LinearToSRGB(float value) {
    return value <= 0.0031308 ? value * 12.92 : 1.055 * pow(value, 1.0 / 2.4) - 0.055;
}
vec3 Electron2D_SRGBToLinear(vec3 value) {
    return vec3(Electron2D_SRGBToLinear(value.r), Electron2D_SRGBToLinear(value.g), Electron2D_SRGBToLinear(value.b));
}
vec3 Electron2D_LinearToSRGB(vec3 value) {
    return vec3(Electron2D_LinearToSRGB(value.r), Electron2D_LinearToSRGB(value.g), Electron2D_LinearToSRGB(value.b));
}
vec4 Electron2D_SRGBToLinear(vec4 value) { return vec4(Electron2D_SRGBToLinear(value.rgb), value.a); }
vec4 Electron2D_LinearToSRGB(vec4 value) { return vec4(Electron2D_LinearToSRGB(value.rgb), value.a); }
#endif
