{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Electron2D Editor",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-editor",
            "program": "${workspaceFolder}/editor/bin/Debug/net10.0/Electron2D.Editor.dll",
            "args": ["--outline"],
            "cwd": "${workspaceFolder}/editor",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
