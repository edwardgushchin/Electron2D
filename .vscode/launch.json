{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Electron2D Editor",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-editor",
            "program": "${workspaceFolder}/editor/bin/Debug/net10.0/Electron2D.Editor",
            "windows": {
                "program": "${workspaceFolder}/editor/bin/Debug/net10.0/Electron2D.Editor.exe"
            },
            "osx": {
                "program": "${workspaceFolder}/editor/bin/Debug/net10.0/Electron2D.app/Contents/MacOS/Electron2D.Editor"
            },
            "args": [],
            "cwd": "${workspaceFolder}/editor",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "CharacterMovement",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-character-movement",
            "program": "${workspaceFolder}/examples/CharacterMovement/bin/Debug/net10.0/CharacterMovement",
            "windows": {
                "program": "${workspaceFolder}/examples/CharacterMovement/bin/Debug/net10.0/CharacterMovement.exe"
            },
            "osx": {
                "program": "${workspaceFolder}/examples/CharacterMovement/bin/Debug/net10.0/CharacterMovement.app/Contents/MacOS/CharacterMovement"
            },
            "args": [],
            "cwd": "${workspaceFolder}/examples/CharacterMovement",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
